#!/bin/bash

set -e

# MaxRegner user configuration
MAXREGNER_USER="${LIVE_USERNAME:-maxregner}"

MAXREGNER_HOME="/home/$MAXREGNER_USER"

# MaxRegner OS - Network Tools Configuration Hook
# Configures comprehensive network utility support
echo "========================================"
echo "MaxRegner OS - Network Tools Hook"
echo "========================================"

# ============================================
# 1. INSTALL NETWORK TOOLS
# ============================================

echo "[1/5] Installing network tools..."

# Install network monitoring tools
apt-get install -y tcpdump wireshark tshark ngrep net-tools \
    iproute2 iputils-ping iputils-tracepath iputils-arping \
    mtr-tiny nmap zenmap netdiscover arp-scan 2>/dev/null || true

# Install network analysis tools
apt-get install -y whois dig host nslookup bind9-host \
    dnsutils netcat netcat-openbsd netcat-traditional \
    socat telnet telnet-ssl 2>/dev/null || true

# Install bandwidth tools
apt-get install -y iperf3 iperf bmon iftop nethogs \
    nload slurm vnstat vnstati 2>/dev/null || true

# Install VPN tools
apt-get install -y openvpn openvpn-systemd-resolved network-manager-openvpn \
    network-manager-openvpn-gnome wireguard wireguard-tools \
    strongswan strongswan-charon strongswan-pki 2>/dev/null || true

# Install proxy tools
apt-get install -y privoxy tinyproxy squid squid-common \
    polipo tor torsocks 2>/dev/null || true

# ============================================
# 2. CONFIGURE NETWORK MONITORING
# ============================================

echo "[2/5] Configuring network monitoring..."

# Configure vnstat
mkdir -p /etc
cat > /etc/vnstat.conf << 'VNSTATCONF'
# MaxRegner OS vnStat Configuration

# Database settings
DatabaseDir "/var/lib/vnstat"
DBIFListFile "/etc/vnstat/iflist"

# Interface settings
Interface "eth0"
Interface "wlan0"
Interface "tun0"

# Logging
LogDir "/var/log/vnstat"
LogDB 1
LogSummary 1

# Update interval
UpdateInterval 300

# MaxRegner specific
MaxBandwidth 1000
MaxHourly 10000
MaxDaily 100000
VNSTATCONF

# Configure iftop
mkdir -p /etc
cat > /etc/iftop.conf << 'IFTOPCONF'
# MaxRegner OS iftop Configuration

# Display settings
line-display=two-line
bytes-display=human-readable

# Sorting
sort=2

# Filtering
filter-code=0

# Port display
show-ports=true

# Host display
show-hosts=true

# MaxRegner specific
use-interface=eth0
IFTOPCONF

# ============================================
# 3. CONFIGURE NMAP
# ============================================

echo "[3/5] Configuring Nmap..."

# Create Nmap configuration
mkdir -p /home/$MAXREGNER_USER
cat > /home/$MAXREGNER_USER/.nmaprc << 'NMAPRC'
# MaxRegner OS Nmap Configuration

# Scan options
--privileged
--script-timeout 30s
--max-retries 3
--max-rate 100

# Timing
-T4

# Scripts
--script vuln
--script discovery
--script auth

# Output
-oN maxregner-scan
-oX maxregner-scan.xml

# MaxRegner specific
--exclude 192.168.1.0/24
--exclude 10.0.0.0/8
--exclude 172.16.0.0/12
NMAPRC

chown ${MAXREGNER_USER}:${MAXREGNER_USER} /home/$MAXREGNER_USER/.nmaprc

# ============================================
# 4. CONFIGURE WIRELESS TOOLS
# ============================================

echo "[4/5] Configuring wireless tools..."

# Install wireless tools
apt-get install -y wireless-tools wpagui wpasupplicant \
    wavemon aircrack-ng reaver 2>/dev/null || true

# Configure wireless settings
mkdir -p /etc/wpa_supplicant
cat > /etc/wpa_supplicant/wpa_supplicant.conf << 'WPASUPCONF'
# MaxRegner OS WPA Supplicant Configuration

# Global settings
ctrl_interface=/var/run/wpa_supplicant
update_config=1

# Network settings
network={
    ssid="MaxRegner"
    psk="maxregner-password"
    key_mgmt=WPA-PSK
    pairwise=CCMP
    group=CCMP
    proto=RSN
}

network={
    ssid="MaxRegner-Guest"
    psk="guest-password"
    key_mgmt=WPA-PSK
    pairwise=CCMP
    group=CCMP
    proto=RSN
}

# MaxRegner specific
country=US
fast_reauth=1
WPASUPCONF

# Configure wireless regulatory domain
mkdir -p /etc/default
cat > /etc/default/crda << 'CRDACONF'
# MaxRegner OS CRDA Configuration

# Regulatory domain
REGDOMAIN=US

# Central regulatory domain agent
DAEMON_OPTS="-u"
CRDACONF

# ============================================
# 5. CONFIGURE NETWORK SCRIPTS
# ============================================

echo "[5/5] Configuring network scripts..."

# Create network utility scripts
mkdir -p /usr/local/bin/maxregner-network
cat > /usr/local/bin/maxregner-network/scan << 'NETSCAN'
# MaxRegner OS Network Scanner Script

echo "========================================"
echo "MaxRegner OS Network Scanner"
echo "========================================"
echo ""

# Check for root
if [ "$(id -u)" -ne 0 ]; then
    echo "Warning: Running as non-root user. Some scans may be limited."
fi

# Get network interface
INTERFACE=$(ip -o link show | awk -F': ' '{print $2}' | grep -v lo | head -1)

if [ -z "$INTERFACE" ]; then
    echo "No network interface found!"
    exit 1
fi

echo "Scanning on interface: $INTERFACE"
echo ""

# Get IP address
IP=$(ip -4 addr show $INTERFACE | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | head -1)
SUBNET=$(echo $IP | cut -d. -f1-3).0/24

echo "Local IP: $IP"
echo "Subnet: $SUBNET"
echo ""

# Ping sweep
echo "Ping sweep..."
for i in $(seq 1 254); do
    TARGET="${SUBNET%/*}.$i"
    if ping -c 1 -W 0.1 $TARGET &>/dev/null; then
        echo "  $TARGET - Active"
        HOSTNAME=$(host $TARGET 2>/dev/null | grep -oP '(?<=domain name pointer\s)\w+')
        if [ -n "$HOSTNAME" ]; then
            echo "    Hostname: $HOSTNAME"
        fi
    fi
done
echo ""

# Port scan on active hosts
echo "Port scanning active hosts..."
ACTIVE_HOSTS=$(nmap -sn $SUBNET | grep -oP '\d+(\.\d+){3}' | grep -v "^0\." | head -10)

for host in $ACTIVE_HOSTS; do
    echo "  Scanning $host..."
    nmap -Pn -p 21-23,80,443,3389,8080 -T4 $host | grep -E "^[0-9]+/tcp" | awk '{print "    Port " $1 " - " $3}'
done
echo ""

echo "========================================"
NETSCAN

cat > /usr/local/bin/maxregner-network/speedtest << 'SPEEDTEST'
# MaxRegner OS Speed Test Script

echo "========================================"
echo "MaxRegner OS Network Speed Test"
echo "========================================"
echo ""

# Check for speedtest-cli
if ! command -v speedtest-cli &>/dev/null; then
    echo "Installing speedtest-cli..."
    apt-get install -y speedtest-cli 2>/dev/null || true
fi

# Run speed test
echo "Running speed test..."
speedtest-cli --simple 2>/dev/null || {
    echo "Speedtest-cli not available. Using alternative method..."
    
    # Download test
    echo "Download test:"
    time wget -q --output-document=/dev/null http://speedtest.net/random2000x2000.jpg 2>&1 | grep real | awk '{print $2}'
    
    # Upload test
    echo "Upload test:"
    echo "  (Upload test requires server)"
}

echo ""
echo "========================================"
SPEEDTEST

cat > /usr/local/bin/maxregner-network/diagnose << 'NETDIAG'
# MaxRegner OS Network Diagnosis Script

echo "========================================"
echo "MaxRegner OS Network Diagnosis"
echo "========================================"
echo ""

# Check connectivity
echo "Checking connectivity..."
if ping -c 4 8.8.8.8 &>/dev/null; then
    echo "  Internet: Connected"
else
    echo "  Internet: Not connected"
fi

# Check DNS
echo "Checking DNS..."
if nslookup google.com &>/dev/null; then
    echo "  DNS: Working"
else
    echo "  DNS: Failed"
fi

# Check gateway
echo "Checking gateway..."
GATEWAY=$(ip route | grep default | awk '{print $3}')
if [ -n "$GATEWAY" ]; then
    echo "  Gateway: $GATEWAY"
    if ping -c 1 $GATEWAY &>/dev/null; then
        echo "  Gateway: Reachable"
    else
        echo "  Gateway: Unreachable"
    fi
else
    echo "  Gateway: Not configured"
fi

# Check interfaces
echo "Checking interfaces..."
ip -br addr show | awk '{print "  " $1 " - " $3}'

# Check routes
echo "Checking routes..."
ip route show | grep -v "^default" | awk '{print "  " $1 " via " $3 " dev " $5}'

echo ""
echo "========================================"
NETDIAG

chmod +x /usr/local/bin/maxregner-network/*

echo ""
echo "========================================"
echo "MaxRegner Network Tools Complete!"
echo "========================================"
