#!/bin/bash

set -e

# MaxRegner user configuration

# MaxRegner OS - Performance Profiles Configuration Hook
# Configures comprehensive performance optimization profiles
echo "========================================"
echo "MaxRegner OS - Performance Profiles Hook"
echo "========================================"

# ============================================
# 1. CREATE PERFORMANCE PROFILE DIRECTORY
# ============================================

echo "[1/5] Creating performance profile directory..."

mkdir -p /etc/maxregner/performance
mkdir -p /usr/local/bin/maxregner-performance

# ============================================
# 2. CONFIGURE WORKLOAD PROFILES
# ============================================

echo "[2/5] Configuring workload profiles..."

# Create performance profile configuration
cat > /etc/maxregner/performance/profiles.conf << 'PROFILESCONF'
# MaxRegner OS Performance Profiles Configuration

# Profile definitions
profiles=gaming,desktop,server,workstation,development

# Default profile
default_profile=desktop

# Profile auto-detection
auto_detect=true

# Profile switching
enable_switching=true
require_password=false
PROFILESCONF

# Create gaming profile
cat > /etc/maxregner/performance/gaming.profile << 'GAMINGPROFILE'
# MaxRegner OS Gaming Performance Profile

# CPU settings
cpu_governor=performance
cpu_min_freq=0
cpu_max_freq=0
cpu_boost=1
cpu_hwp_dyn_boost=1

# Memory settings
swappiness=10
vfs_cache_pressure=50

# I/O settings
io_scheduler=none
readahead=8192

# Network settings
tcp_congestion_control=cubic

# GPU settings
gpu_power_profile=performance
gpu_mem_clock=max
gpu_core_clock=max

# Power settings
power_save=false

# Process settings
nice_level=-20
rt_priority=99

# Description
name=Gaming
description=Maximum performance for gaming
priority=100
GAMINGPROFILE

# Create desktop profile
cat > /etc/maxregner/performance/desktop.profile << 'DESKTOPPROFILE'
# MaxRegner OS Desktop Performance Profile

# CPU settings
cpu_governor=ondemand
cpu_min_freq=0
cpu_max_freq=0
cpu_boost=1
cpu_hwp_dyn_boost=1

# Memory settings
swappiness=10
vfs_cache_pressure=50

# I/O settings
io_scheduler=bfq
readahead=4096

# Network settings
tcp_congestion_control=cubic

# GPU settings
gpu_power_profile=auto
gpu_mem_clock=auto
gpu_core_clock=auto

# Power settings
power_save=false

# Process settings
nice_level=0
rt_priority=0

# Description
name=Desktop
description=Balanced performance for desktop use
priority=50
DESKTOPPROFILE

# Create server profile
cat > /etc/maxregner/performance/server.profile << 'SERVERPROFILE'
# MaxRegner OS Server Performance Profile

# CPU settings
cpu_governor=ondemand
cpu_min_freq=0
cpu_max_freq=0
cpu_boost=0
cpu_hwp_dyn_boost=0

# Memory settings
swappiness=10
vfs_cache_pressure=10

# I/O settings
io_scheduler=deadline
readahead=4096

# Network settings
tcp_congestion_control=cubic

# GPU settings
gpu_power_profile=auto
gpu_mem_clock=min
gpu_core_clock=min

# Power settings
power_save=true

# Process settings
nice_level=0
rt_priority=0

# Description
name=Server
description=Optimized for server workloads
priority=20
SERVERPROFILE

# ============================================
# 3. CREATE PROFILE SWITCHING SCRIPT
# ============================================

echo "[3/5] Creating profile switching script..."

cat > /usr/local/bin/maxregner-performance/switch-profile << 'SWITCHPROFILE'
# MaxRegner OS Performance Profile Switcher

PROFILE_DIR="/etc/maxregner/performance"
CURRENT_PROFILE_FILE="/etc/maxregner/performance/current_profile"

# Check if profile exists
if [ -z "$1" ]; then
    echo "Usage: switch-profile <profile>"
    echo "Available profiles:"
    ls "$PROFILE_DIR"/*.profile | xargs -n1 basename | sed 's/.profile//'
    exit 1
fi

PROFILE="$1"
PROFILE_FILE="$PROFILE_DIR/$PROFILE.profile"

if [ ! -f "$PROFILE_FILE" ]; then
    echo "Error: Profile '$PROFILE' not found!"
    exit 1
fi

# Load profile settings
echo "Switching to profile: $PROFILE"

# Apply CPU settings
CPU_GOVERNOR=$(grep "^cpu_governor=" "$PROFILE_FILE" | cut -d= -f2)
if [ -n "$CPU_GOVERNOR" ]; then
    echo "Setting CPU governor to: $CPU_GOVERNOR"
    for cpu in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
        echo "$CPU_GOVERNOR" > "$cpu" 2>/dev/null || true
    done
fi

# Apply memory settings
SWAPPINESS=$(grep "^swappiness=" "$PROFILE_FILE" | cut -d= -f2)
if [ -n "$SWAPPINESS" ]; then
    echo "Setting swappiness to: $SWAPPINESS"
    sysctl vm.swappiness="$SWAPPINESS" 2>/dev/null || true
fi

VFS_PRESSURE=$(grep "^vfs_cache_pressure=" "$PROFILE_FILE" | cut -d= -f2)
if [ -n "$VFS_PRESSURE" ]; then
    echo "Setting vfs_cache_pressure to: $VFS_PRESSURE"
    sysctl vm.vfs_cache_pressure="$VFS_PRESSURE" 2>/dev/null || true
fi

# Apply I/O settings
IO_SCHEDULER=$(grep "^io_scheduler=" "$PROFILE_FILE" | cut -d= -f2)
if [ -n "$IO_SCHEDULER" ]; then
    echo "Setting I/O scheduler to: $IO_SCHEDULER"
    for disk in /sys/block/sd[a-z] /sys/block/nvme[0-9]n[0-9]; do
        if [ -e "$disk/queue/scheduler" ]; then
            echo "$IO_SCHEDULER" > "$disk/queue/scheduler" 2>/dev/null || true
        fi
    done
fi

# Save current profile
echo "$PROFILE" > "$CURRENT_PROFILE_FILE"

# Notify user
if [ -n "$DISPLAY" ]; then
    notify-send "Performance Profile" "Switched to: $PROFILE"
fi

echo "Switched to profile: $PROFILE"
SWITCHPROFILE

chmod +x /usr/local/bin/maxregner-performance/switch-profile

# ============================================
# 4. CREATE PERFORMANCE MONITOR
# ============================================

echo "[4/5] Creating performance monitor..."

cat > /usr/local/bin/maxregner-performance/monitor << 'PERFMON'
# MaxRegner OS Performance Monitor

CURRENT_PROFILE_FILE="/etc/maxregner/performance/current_profile"

# Get current profile
if [ -f "$CURRENT_PROFILE_FILE" ]; then
    CURRENT_PROFILE=$(cat "$CURRENT_PROFILE_FILE")
else
    CURRENT_PROFILE="desktop"
fi

echo "========================================"
echo "MaxRegner OS Performance Monitor"
echo "Current Profile: $CURRENT_PROFILE"
echo "========================================"
echo ""

# CPU information
echo "CPU:"
CPU_GOVERNOR=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo "unknown")
echo "  Governor: $CPU_GOVERNOR"
CPU_USAGE=$(top -bn1 | grep "Cpu(s)" | sed "s/.*, *\([0-9.]*\)%* id.*/\1/" | awk '{print 100 - $1}')
echo "  Usage: ${CPU_USAGE}%"

# Memory information
echo ""
echo "Memory:"
MEM_USAGE=$(free | awk '/Mem:/ {printf "%.2f", $3/$2*100}')
echo "  Usage: ${MEM_USAGE}%"
SWAPPINESS=$(sysctl vm.swappiness | awk '{print $3}')
echo "  Swappiness: $SWAPPINESS"

# I/O information
echo ""
echo "I/O:"
for disk in /sys/block/sd[a-z] /sys/block/nvme[0-9]n[0-9]; do
    if [ -e "$disk/queue/scheduler" ]; then
        SCHEDULER=$(cat "$disk/queue/scheduler" 2>/dev/null || echo "unknown")
        DISK_NAME=$(basename "$disk")
        echo "  $DISK_NAME: $SCHEDULER"
    fi
done

# Network information
echo ""
echo "Network:"
TCP_CC=$(sysctl net.ipv4.tcp_congestion_control | awk '{print $3}')
echo "  Congestion Control: $TCP_CC"

# GPU information
if lspci | grep -q "VGA"; then
    echo ""
    echo "GPU:"
    lspci | grep VGA | awk -F': ' '{print "  " $2}'
fi

echo ""
echo "========================================"
PERFMON

chmod +x /usr/local/bin/maxregner-performance/monitor

# ============================================
# 5. CREATE PERFORMANCE OPTIMIZATION SCRIPT
# ============================================

echo "[5/5] Creating performance optimization script..."

cat > /usr/local/bin/maxregner-performance/optimize << 'PERFOPT'
# MaxRegner OS Performance Optimization Script

echo "========================================"
echo "MaxRegner OS Performance Optimization"
echo "========================================"
echo ""

# Check current profile
CURRENT_PROFILE_FILE="/etc/maxregner/performance/current_profile"
if [ -f "$CURRENT_PROFILE_FILE" ]; then
    CURRENT_PROFILE=$(cat "$CURRENT_PROFILE_FILE")
else
    CURRENT_PROFILE="desktop"
fi

echo "Current profile: $CURRENT_PROFILE"
echo ""

# Optimize based on profile
case "$CURRENT_PROFILE" in
    gaming)
        echo "Optimizing for gaming..."
        # Enable performance mode
        /usr/local/bin/maxregner-power/performance
        
        # Set real-time priority for games
        renice -n -20 -p $(pidof gamescope) 2>/dev/null || true
        renice -n -20 -p $(pidof wine) 2>/dev/null || true
        renice -n -20 -p $(pidof steam) 2>/dev/null || true
        
        # Enable GameMode
        gamemoderun true 2>/dev/null || true
        ;;
    desktop)
        echo "Optimizing for desktop..."
        # Enable balanced mode
        /usr/local/bin/maxregner-power/balanced
        
        # Optimize for responsiveness
        sysctl kernel.sched_latency_ns=6000000 2>/dev/null || true
        sysctl kernel.sched_wakeup_granularity_ns=1500000 2>/dev/null || true
        ;;
    server)
        echo "Optimizing for server..."
        # Enable power save mode
        /usr/local/bin/maxregner-power/powersave
        
        # Optimize for throughput
        sysctl kernel.sched_latency_ns=10000000 2>/dev/null || true
        sysctl kernel.sched_wakeup_granularity_ns=2000000 2>/dev/null || true
        ;;
    *)
        echo "Optimizing for default profile..."
        /usr/local/bin/maxregner-power/balanced
        ;;
esac

# Apply kernel optimizations
sysctl vm.swappiness=10 2>/dev/null || true
sysctl vm.vfs_cache_pressure=50 2>/dev/null || true
sysctl kernel.sched_min_granularity_ns=1000000 2>/dev/null || true

# Optimize I/O
for disk in /sys/block/sd[a-z] /sys/block/nvme[0-9]n[0-9]; do
    if [ -e "$disk/queue/scheduler" ]; then
        echo deadline > "$disk/queue/scheduler" 2>/dev/null || true
    fi
    if [ -e "$disk/queue/read_ahead_kb" ]; then
        echo 4096 > "$disk/queue/read_ahead_kb" 2>/dev/null || true
    fi
done

# Optimize network
sysctl net.core.netdev_max_backlog=5000 2>/dev/null || true
sysctl net.core.somaxconn=4096 2>/dev/null || true
sysctl net.ipv4.tcp_fin_timeout=30 2>/dev/null || true
sysctl net.ipv4.tcp_keepalive_time=300 2>/dev/null || true

echo ""
echo "Performance optimization complete!"
PERFOPT

chmod +x /usr/local/bin/maxregner-performance/optimize

echo ""
echo "========================================"
echo "MaxRegner Performance Profiles Complete!"
echo "========================================"
