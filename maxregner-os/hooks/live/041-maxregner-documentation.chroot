#!/bin/bash

set -e

# MaxRegner user configuration

# MaxRegner OS - Documentation and Help System Configuration Hook
# Configures comprehensive documentation support
echo "========================================"
echo "MaxRegner OS - Documentation Hook"
echo "========================================"

# ============================================
# 1. INSTALL DOCUMENTATION TOOLS
# ============================================

echo "[1/5] Installing documentation tools..."

# Install documentation packages
apt-get install -y man man-db manpages manpages-dev manpages-posix \
    manpages-posix-dev info info-browser gnu-info 2>/dev/null || true

# Install help viewers
apt-get install -y yelp yelp-xsl devhelp devhelp-common \
    gnome-help gnome-user-docs 2>/dev/null || true

# Install documentation generators
apt-get install -y doxygen doxygen-doc doxygen-latex doxygen-gui \
    sphinx-common sphinx-doc python3-sphinx 2>/dev/null || true

# Install Markdown tools
apt-get install -y pandoc pandoc-data pandoc-citeproc \
    markdown ghostscript texlive-xetex texlive-latex-extra \
    texlive-fonts-recommended texlive-fonts-extra 2>/dev/null || true

# ============================================
# 2. CONFIGURE MAN PAGES
# ============================================

echo "[2/5] Configuring man pages..."

# Configure man-db
mkdir -p /etc
cat > /etc/manpath.config << 'MANPATHCONF'
# MaxRegner OS Manpath Configuration

# Manpath map
MANPATH_MAP /usr/bin /usr/share/man
MANPATH_MAP /usr/sbin /usr/share/man
MANPATH_MAP /bin /usr/share/man
MANPATH_MAP /sbin /usr/share/man
MANPATH_MAP /usr/local/bin /usr/local/share/man
MANPATH_MAP /usr/local/sbin /usr/local/share/man
MANPATH_MAP /opt /opt/share/man
MANPATH_MAP /home/*/bin /home/*/share/man

# Mandatory manpaths
MANDATORY_MANPATH /usr/share/man
MANDATORY_MANPATH /usr/local/share/man
MANDATORY_MANPATH /usr/local/man

# Section ordering
SECTION 1 1p 8 2 3 3p 4 5 6 7 9 0p n l p o 1x 2x 3x 4x 5x 6x 7x 8x 9x

# MaxRegner specific
MAXREGNER_MANPATH /usr/share/maxregner/man
MANPATHCONF

# Create MaxRegner man pages
mkdir -p /usr/share/maxregner/man/man1
cat > /usr/share/maxregner/man/man1/maxregner.1 << 'MAXMAN1'
." MaxRegner OS Manual Page
.TH MAXREGNER 1 "2024-01-01" "MaxRegner OS 1.0" "MaxRegner OS User Manual"
.SH NAME
maxregner \- MaxRegner OS user commands
.SH SYNOPSIS
.B maxregner [OPTION]...
.SH DESCRIPTION
.PP
MaxRegner OS is a custom Linux distribution based on Debian, optimized for
performance, security, and user experience.
.PP
This manual page describes the MaxRegner OS specific commands and features.
.SH OPTIONS
.TP
.B \-h, \-\-help
Show help message and exit.
.TP
.B \-v, \-\-version
Show version information and exit.
.TP
.B update
Update the system packages.
.TP
.B cleanup
Clean up the system.
.TP
.B backup
Create a system backup.
.TP
.B monitor
Monitor system resources.
.TP
.B info
Show system information.
.SH EXAMPLES
.TP
.B maxregner update
Update all system packages.
.TP
.B maxregner info
Show system information.
.SH FILES
.TP
.I /usr/local/bin/maxregner-*
MaxRegner OS scripts and utilities.
.TP
.I /etc/maxregner
MaxRegner OS configuration files.
.SH SEE ALSO
.BR man (1),
.BR apt (8),
.BR systemd (1)
.SH BUGS
Report bugs to: support@maxregneros.com
.SH AUTHOR
MaxRegner Team
MAXMAN1

chmod 644 /usr/share/maxregner/man/man1/maxregner.1

# ============================================
# 3. CONFIGURE INFO PAGES
# ============================================

echo "[3/5] Configuring info pages..."

# Create MaxRegner info pages
mkdir -p /usr/share/info/maxregner
cat > /usr/share/info/maxregner << 'MAXINFO'
This is the MaxRegner OS Info page.

* Menu:

* Introduction::          About MaxRegner OS
* Installation::          How to install MaxRegner OS
* Configuration::        Configuring MaxRegner OS
* Commands::             MaxRegner OS commands
* Troubleshooting::      Common issues and solutions
* FAQ::                  Frequently Asked Questions

File: maxregner,  Node: Top,  Next: Introduction,  Up: (dir)

MaxRegner OS Documentation
**************************

This documentation provides comprehensive information about MaxRegner OS.

* Introduction
--------------

MaxRegner OS is a custom Linux distribution based on Debian, designed
for optimal performance, security, and user experience.

* Features

- Optimized kernel with custom tuning
- Comprehensive hardware detection
- Advanced power management
- Complete multimedia support
- Development tools pre-configured
- Gaming support
- Virtualization support
- Container support
- Cloud integration
- Comprehensive security
- System monitoring
- Backup solutions
- Accessibility features
- Internationalization support

* Installation
------------

To install MaxRegner OS, follow these steps:

1. Download the ISO image from the official website
2. Create a bootable USB drive
3. Boot from the USB drive
4. Follow the installation prompts
5. Reboot and enjoy MaxRegner OS

* Configuration
--------------

MaxRegner OS can be configured using:

- GNOME Settings
- Command line tools
- Configuration files in /etc/maxregner/
- Custom scripts in /usr/local/bin/maxregner-*

* Commands
---------

MaxRegner OS provides the following custom commands:

maxregner-update    - Update the system
maxregner-cleanup   - Clean up the system
maxregner-backup    - Create a backup
maxregner-monitor   - Monitor system resources
maxregner-info      - Show system information

* Troubleshooting
---------------

Common issues and their solutions:

1. No sound: Check if PulseAudio is running
2. No network: Check if NetworkManager is running
3. Slow performance: Try switching to performance profile
4. High temperature: Check fan control settings

* FAQ
----

Q: How do I update MaxRegner OS?
A: Run 'sudo maxregner-update'

Q: How do I switch performance profiles?
A: Use 'sudo maxregner-performance/switch-profile <profile>'

Q: How do I get help?
A: Run 'maxregner-welcome' or visit https://maxregneros.com

Q: Where are the configuration files?
A: Configuration files are in /etc/maxregner/

MAXINFO

# ============================================
# 4. CREATE DOCUMENTATION DIRECTORY
# ============================================

echo "[4/5] Creating documentation directory..."

# Create documentation directory
mkdir -p /usr/share/maxregner/doc
mkdir -p /usr/share/maxregner/doc/html
mkdir -p /usr/share/maxregner/doc/pdf
mkdir -p /usr/share/maxregner/doc/man

# Create HTML documentation
cat > /usr/share/maxregner/doc/html/index.html << 'MAXDOCHTML'
