# ============================================
# 5. CREATE HELP SYSTEM
# ============================================

echo "[5/5] Creating help system..."

# Create help command
mkdir -p /usr/local/bin
cat > /usr/local/bin/maxregner-help << 'MAXHELP'
# MaxRegner OS Help System

if [ -z "$1" ]; then
    echo "=========================================="
    echo "MaxRegner OS Help System"
    echo "=========================================="
    echo ""
    echo "Usage: maxregner-help [command|topic]"
    echo ""
    echo "Available commands:"
    echo "  update          - Update the system"
    echo "  cleanup         - Clean up the system"
    echo "  backup          - Create a backup"
    echo "  monitor         - Monitor system resources"
    echo "  info            - Show system information"
    echo ""
    echo "Available topics:"
    echo "  introduction    - About MaxRegner OS"
    echo "  installation    - Installation guide"
    echo "  configuration   - Configuration options"
    echo "  commands        - List of commands"
    echo "  features        - List of features"
    echo "  troubleshooting - Common issues"
    echo ""
    echo "Documentation locations:"
    echo "  HTML: /usr/share/maxregner/doc/html/"
    echo "  Man pages: /usr/share/maxregner/man/"
    echo "  Info pages: /usr/share/info/maxregner"
    echo ""
    echo "For more information, visit: https://maxregneros.com"
    exit 0
fi

TOPIC="$1"

case "$TOPIC" in
    update)
        echo "maxregner-update - Update the system"
        echo ""
        echo "Usage: sudo maxregner-update"
        echo ""
        echo "Description:"
        echo "  Updates all system packages, performs distro upgrade,"
        echo "  cleans up old packages, and updates initramfs and GRUB."
        ;;
    cleanup)
        echo "maxregner-cleanup - Clean up the system"
        echo ""
        echo "Usage: sudo maxregner-cleanup"
        echo ""
        echo "Description:"
        echo "  Cleans package cache, removes old kernels, cleans"
        echo "  temporary files, old logs, and unused container images."
        ;;
    backup)
        echo "maxregner-backup - Create a backup"
        echo ""
        echo "Usage: sudo maxregner-backup"
        echo ""
        echo "Description:"
        echo "  Creates a compressed backup of important system directories"
        echo "  and stores it in /var/backups/maxregner/."
        ;;
    monitor)
        echo "maxregner-monitor - Monitor system resources"
        echo ""
        echo "Usage: maxregner-monitor"
        echo ""
        echo "Description:"
        echo "  Displays CPU, memory, disk, and network information."
        ;;
    info)
        echo "maxregner-info - Show system information"
        echo ""
        echo "Usage: maxregner-info"
        echo ""
        echo "Description:"
        echo "  Shows comprehensive system information including OS,"
        echo "  kernel, CPU, memory, disk, network, and graphics."
        ;;
    introduction)
        echo "=========================================="
        echo "MaxRegner OS - Introduction"
        echo "=========================================="
        echo ""
        echo "MaxRegner OS is a custom Linux distribution based on Debian,"
        echo "designed for optimal performance, security, and user experience."
        echo ""
        echo "Key features:"
        echo "  - Optimized kernel with custom tuning"
        echo "  - Comprehensive hardware detection"
        echo "  - Advanced power management"
        echo "  - Complete multimedia support"
        echo "  - Development tools pre-configured"
        echo "  - Gaming support"
        echo "  - Virtualization support"
        echo "  - Container support"
        echo "  - Cloud integration"
        echo "  - Comprehensive security"
        echo "  - System monitoring"
        echo "  - Backup solutions"
        echo ""
        echo "For more information, visit: https://maxregneros.com"
        ;;
    installation)
        echo "=========================================="
        echo "MaxRegner OS - Installation"
        echo "=========================================="
        echo ""
        echo "To install MaxRegner OS:"
        echo ""
        echo "1. Download the ISO from https://maxregneros.com"
        echo "2. Create a bootable USB drive using dd or balenaEtcher"
        echo "   Example with dd:"
        echo "     sudo dd if=maxregner-os.iso of=/dev/sdX bs=4M status=progress"
        echo "3. Boot from the USB drive"
        echo "4. Follow the installation prompts"
        echo "5. Reboot and enjoy MaxRegner OS"
        echo ""
        echo "Minimum requirements:"
        echo "  - 2 GHz dual-core processor"
        echo "  - 2 GB RAM"
        echo "  - 25 GB disk space"
        echo "  - VGA capable of 1024x768 resolution"
        ;;
    configuration)
        echo "=========================================="
        echo "MaxRegner OS - Configuration"
        echo "=========================================="
        echo ""
        echo "MaxRegner OS can be configured using:"
        echo ""
        echo "1. GNOME Settings application"
        echo "2. Command line tools"
        echo "3. Configuration files in /etc/maxregner/"
        echo "4. Custom scripts in /usr/local/bin/maxregner-*"
        echo ""
        echo "Common configuration files:"
        echo "  /etc/maxregner/performance/profiles.conf - Performance profiles"
        echo "  /etc/maxregner/security/ - Security settings"
        echo "  /etc/maxregner/network/ - Network settings"
        echo ""
        echo "To edit configuration files, use:"
        echo "  sudo nano /path/to/config"
        ;;
    commands)
        echo "=========================================="
        echo "MaxRegner OS - Commands"
        echo "=========================================="
        echo ""
        echo "MaxRegner OS provides the following custom commands:"
        echo ""
        echo "System commands:"
        echo "  maxregner-update    - Update the system"
        echo "  maxregner-cleanup   - Clean up the system"
        echo "  maxregner-backup    - Create a backup"
        echo "  maxregner-monitor   - Monitor system resources"
        echo "  maxregner-info      - Show system information"
        echo ""
        echo "Performance commands:"
        echo "  maxregner-performance/switch-profile <profile> - Switch performance profile"
        echo "  maxregner-performance/monitor         - Monitor performance"
        echo "  maxregner-performance/optimize        - Optimize performance"
        echo ""
        echo "Power commands:"
        echo "  maxregner-power/performance - Activate performance profile"
        echo "  maxregner-power/powersave   - Activate powersave profile"
        echo "  maxregner-power/balanced    - Activate balanced profile"
        echo ""
        echo "Network commands:"
        echo "  maxregner-network/scan      - Scan network"
        echo "  maxregner-network/speedtest - Test network speed"
        echo "  maxregner-network/diagnose - Diagnose network issues"
        ;;
    features)
        echo "=========================================="
        echo "MaxRegner OS - Features"
        echo "=========================================="
        echo ""
        echo "MaxRegner OS includes the following features:"
        echo ""
        echo "Kernel and System:"
        echo "  - Optimized kernel parameters"
        echo "  - Custom sysctl settings"
        echo "  - Hardware detection and configuration"
        echo ""
        echo "Performance:"
        echo "  - Performance profiles (gaming, desktop, server)"
        echo "  - CPU governor tuning"
        echo "  - Memory and I/O optimization"
        echo ""
        echo "Power Management:"
        echo "  - TLP power management"
        echo "  - thermald thermal management"
        echo "  - Laptop mode tools"
        echo "  - Custom power profiles"
        echo ""
        echo "Multimedia:"
        echo "  - Complete codec support"
        echo "  - FFmpeg with custom presets"
        echo "  - GStreamer configuration"
        echo "  - VA-API and VDPAU acceleration"
        echo ""
        echo "Development:"
        echo "  - Python, Node.js, Java development"
        echo "  - Git configuration"
        echo "  - Docker and Podman"
        echo "  - IDE support"
        ;;
    troubleshooting)
        echo "=========================================="
        echo "MaxRegner OS - Troubleshooting"
        echo "=========================================="
        echo ""
        echo "Common issues and their solutions:"
        echo ""
        echo "1. No sound:"
        echo "   - Check if PulseAudio is running: systemctl status pulseaudio"
        echo "   - Check volume: alsamixer"
        echo "   - Check audio devices: aplay -l"
        echo ""
        echo "2. No network:"
        echo "   - Check if NetworkManager is running: systemctl status NetworkManager"
        echo "   - Check interfaces: ip a"
        echo "   - Check routes: ip route"
        echo ""
        echo "3. Slow performance:"
        echo "   - Check CPU usage: top"
        echo "   - Check memory usage: free -h"
        echo "   - Try switching profile: sudo maxregner-performance/switch-profile gaming"
        echo ""
        echo "4. High temperature:"
        echo "   - Check sensors: sensors"
        echo "   - Check fan control: systemctl status fancontrol"
        echo "   - Check thermal daemon: systemctl status thermald"
        echo ""
        echo "5. Graphics issues:"
        echo "   - Check GPU: lspci | grep VGA"
        echo "   - Check drivers: lspci -k | grep -A 3 VGA"
        echo "   - Check Vulkan: vulkaninfo | grep GPU"
        echo ""
        echo "6. Package management issues:"
        echo "   - Fix broken packages: sudo apt --fix-broken install"
        echo "   - Update package lists: sudo apt update"
        echo "   - Clean cache: sudo apt clean"
        ;;
    *)
        echo "Error: Unknown topic '$TOPIC'"
        echo "Type 'maxregner-help' for a list of available topics."
        exit 1
        ;;
esac
MAXHELP

chmod +x /usr/local/bin/maxregner-help

echo ""
echo "========================================"
echo "MaxRegner Documentation Complete!"
echo "========================================"
