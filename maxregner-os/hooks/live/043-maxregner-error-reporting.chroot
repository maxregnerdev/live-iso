#!/bin/bash
# MaxRegner OS - Error Reporting Configuration Hook
# Configures comprehensive error reporting system

set -e

echo "========================================"
echo "MaxRegner OS - Error Reporting Hook"
echo "========================================"

# ============================================
# 1. INSTALL ERROR REPORTING TOOLS
# ============================================

echo "[1/5] Installing error reporting tools..."

# Install error reporting packages
apt-get install -y apport apport-gtk apport-kde apport-retrace \
    apport-symptoms whoopsie whoopsie-preferences \
    ubuntu-bug launchpad-getkeys 2>/dev/null || true

# Install logging tools
apt-get install -y rsyslog syslog-ng logwatch logrotate \
    swatch snoopy 2>/dev/null || true

# Install debugging tools
apt-get install -y gdb gdbserver strace ltrace valgrind \
    kdump-tools crash kexec-tools 2>/dev/null || true

# ============================================
# 2. CONFIGURE APOPORT
# ============================================

echo "[2/5] Configuring Apport..."

# Configure Apport
cat > /etc/apport/crashdb.conf << 'APPORTCONF'
# MaxRegner OS Apport Configuration

[DEFAULT]
file_pattern = /var/log/apport.log
blacklist_pattern = 

[ProblemTypes]
package = true
kernel = true
python = true

[CrashDB]
active = true
db = ubuntu
distribution = maxregner

[MaxRegner]
enabled = true
crashdb_url = https://errors.maxregneros.com/
report_url = https://errors.maxregneros.com/report

[Hooks]
pre = /etc/apport/pre-hook.d/maxregner
post = /etc/apport/post-hook.d/maxregner
APPORTCONF

# Configure Apport settings
cat > /etc/default/apport << 'APPORTDEFAULT'
# MaxRegner OS Apport Default Configuration

# Enable Apport
ENABLED=1

# Crash file pattern
PATTERN="/var/log/apport.log"

# Blacklist pattern
BLACKLIST_PATTERN=""

# MaxRegner specific
MAXREGNER_APPORT=1
APPORTDEFAULT

# Create Apport hooks
mkdir -p /etc/apport/pre-hook.d
mkdir -p /etc/apport/post-hook.d

cat > /etc/apport/pre-hook.d/maxregner << 'APPORTHOOK'
#!/bin/bash
# MaxRegner OS Apport Pre-Hook

# Log the crash
logger -t apport "Crash detected: $PACKAGE $VERSION"

# Create MaxRegner specific log
mkdir -p /var/log/maxregner/crashes
CRASH_LOG="/var/log/maxregner/crashes/$(date +%Y%m%d_%H%M%S)_${PACKAGE}.log"

echo "MaxRegner OS Crash Report" > "$CRASH_LOG"
echo "=======================" >> "$CRASH_LOG"
echo "Package: $PACKAGE" >> "$CRASH_LOG"
echo "Version: $VERSION" >> "$CRASH_LOG"
echo "Executable: $EXECUTABLE" >> "$CRASH_LOG"
echo "Timestamp: $(date)" >> "$CRASH_LOG"
echo "" >> "$CRASH_LOG"

# Add system information
echo "System Information:" >> "$CRASH_LOG"
echo "  OS: MaxRegner OS" >> "$CRASH_LOG"
echo "  Kernel: $(uname -r)" >> "$CRASH_LOG"
echo "  Architecture: $(uname -m)" >> "$CRASH_LOG"
echo "  Hostname: $(hostname)" >> "$CRASH_LOG"
echo "" >> "$CRASH_LOG"

chmod 644 "$CRASH_LOG"
APPORTHOOK

chmod +x /etc/apport/pre-hook.d/maxregner

cat > /etc/apport/post-hook.d/maxregner << 'APPORTPOSTHOOK'
#!/bin/bash
# MaxRegner OS Apport Post-Hook

# Notify system administrator
if [ -n "$DISPLAY" ]; then
    notify-send "MaxRegner OS Crash" "Crash in $PACKAGE $VERSION"
fi

# Log the report
logger -t apport "Crash report generated for: $PACKAGE $VERSION"

# Create notification file
mkdir -p /var/lib/maxregner/crash-notifications
NOTIFY_FILE="/var/lib/maxregner/crash-notifications/$(date +%Y%m%d_%H%M%S)_${PACKAGE}"
echo "Crash detected in $PACKAGE $VERSION at $(date)" > "$NOTIFY_FILE"

# MaxRegner specific cleanup
if [ -f /tmp/apport-$PACKAGE-$VERSION ]; then
    rm -f /tmp/apport-$PACKAGE-$VERSION
fi
APPORTPOSTHOOK

chmod +x /etc/apport/post-hook.d/maxregner

# ============================================
# 3. CONFIGURE RSYSLOG
# ============================================

echo "[3/5] Configuring rsyslog..."

# Configure rsyslog
cat > /etc/rsyslog.conf << 'RSYSLOGCONF'
# MaxRegner OS rsyslog Configuration

# Modules
module(load="imuxsock")
module(load="imklog")

# Global settings
$ActionFileDefaultTemplate RSYSLOG_FileTemplate

# MaxRegner specific templates
template(name="MaxRegnerFormat" type="string"
    string="%timegenerated% %HOSTNAME% %syslogtag%%msg:::sp-if-no-1st-sp%%msg:::drop-last-lf%\n"
)

# Filter for MaxRegner logs
if $programname == 'maxregner' then {
    action(type="omfile" file="/var/log/maxregner.log" template="MaxRegnerFormat")
    stop
}

# Filter for crashes
if $msg contains 'crash' or $msg contains 'Crash' or $msg contains 'segfault' then {
    action(type="omfile" file="/var/log/maxregner/crashes.log" template="MaxRegnerFormat")
    stop
}

# Filter for errors
if $syslogseverity-text == 'err' or $syslogseverity-text == 'error' then {
    action(type="omfile" file="/var/log/maxregner/errors.log" template="MaxRegnerFormat")
}

# Filter for warnings
if $syslogseverity-text == 'warning' or $syslogseverity-text == 'warn' then {
    action(type="omfile" file="/var/log/maxregner/warnings.log" template="MaxRegnerFormat")
}

# Kernel logs
kern.*                          /var/log/kern.log

# System logs
auth,authpriv.*                 /var/log/auth.log
*.*                             /var/log/syslog

# Cron logs
cron.*                          /var/log/cron.log

# Mail logs
mail.*                          /var/log/mail.log

# MaxRegner specific
maxregner.*                     /var/log/maxregner/maxregner.log
apport.*                        /var/log/maxregner/apport.log
RSYSLOGCONF

# Create log directories
mkdir -p /var/log/maxregner
mkdir -p /var/log/maxregner/crashes
touch /var/log/maxregner.log
touch /var/log/maxregner/crashes.log
touch /var/log/maxregner/errors.log
touch /var/log/maxregner/warnings.log

chmod 755 /var/log/maxregner
chmod 644 /var/log/maxregner/*

# ============================================
# 4. CONFIGURE LOGWATCH
# ============================================

echo "[4/5] Configuring logwatch..."

# Configure logwatch
cat > /etc/logwatch/conf/logwatch.conf << 'LOGWATCHCONF'
# MaxRegner OS Logwatch Configuration

# Mail settings
MailTo = root@localhost
MailFrom = logwatch@maxregner-os

# Detail level
Detail = High

# Service settings
Service = All
Service = "-zz-network"
Service = "-zz-sys"
Service = "-eximstats"

# Range
Range = yesterday

# MaxRegner specific
MaxRegner = 1
LOGWATCHCONF

# Create custom logwatch service
mkdir -p /etc/logwatch/scripts/services
cat > /etc/logwatch/scripts/services/maxregner << 'LOGWATCHSERVICE'
#!/bin/bash
# MaxRegner OS Logwatch Service

# Check MaxRegner logs
if [ -f /var/log/maxregner.log ]; then
    echo "MaxRegner OS Logs:"
    echo "=================="
    tail -20 /var/log/maxregner.log
    echo ""
fi

# Check crash logs
if [ -f /var/log/maxregner/crashes.log ]; then
    echo "Crash Logs:"
    echo "=========="
    tail -10 /var/log/maxregner/crashes.log
    echo ""
fi

# Check error logs
if [ -f /var/log/maxregner/errors.log ]; then
    echo "Error Logs:"
    echo "=========="
    tail -10 /var/log/maxregner/errors.log
    echo ""
fi

# Check warning logs
if [ -f /var/log/maxregner/warnings.log ]; then
    echo "Warning Logs:"
    echo "============"
    tail -10 /var/log/maxregner/warnings.log
    echo ""
fi

# Check Apport logs
if [ -f /var/log/maxregner/apport.log ]; then
    echo "Apport Logs:"
    echo "==========="
    tail -10 /var/log/maxregner/apport.log
    echo ""
fi
LOGWATCHSERVICE

chmod +x /etc/logwatch/scripts/services/maxregner

# ============================================
# 5. CONFIGURE ERROR NOTIFICATION
# ============================================

echo "[5/5] Configuring error notification..."

# Create error notification script
cat > /usr/local/bin/maxregner-error-notify << 'ERRORNOTIFY'
#!/bin/bash
# MaxRegner OS Error Notification Script

set -e

# Check for new errors
ERROR_LOG="/var/log/maxregner/errors.log"
WARNING_LOG="/var/log/maxregner/warnings.log"
CRASH_LOG="/var/log/maxregner/crashes.log"

# Check if logs exist
if [ ! -f "$ERROR_LOG" ] && [ ! -f "$WARNING_LOG" ] && [ ! -f "$CRASH_LOG" ]; then
    echo "No error logs found"
    exit 0
fi

# Check for new errors
NEW_ERRORS=0

if [ -f "$ERROR_LOG" ]; then
    ERROR_COUNT=$(grep -c "$(date +%Y-%m-%d)" "$ERROR_LOG" 2>/dev/null || echo 0)
    if [ "$ERROR_COUNT" -gt 0 ]; then
        NEW_ERRORS=$((NEW_ERRORS + ERROR_COUNT))
        echo "Found $ERROR_COUNT new errors"
    fi
fi

if [ -f "$WARNING_LOG" ]; then
    WARNING_COUNT=$(grep -c "$(date +%Y-%m-%d)" "$WARNING_LOG" 2>/dev/null || echo 0)
    if [ "$WARNING_COUNT" -gt 0 ]; then
        NEW_ERRORS=$((NEW_ERRORS + WARNING_COUNT))
        echo "Found $WARNING_COUNT new warnings"
    fi
fi

if [ -f "$CRASH_LOG" ]; then
    CRASH_COUNT=$(grep -c "$(date +%Y-%m-%d)" "$CRASH_LOG" 2>/dev/null || echo 0)
    if [ "$CRASH_COUNT" -gt 0 ]; then
        NEW_ERRORS=$((NEW_ERRORS + CRASH_COUNT))
        echo "Found $CRASH_COUNT new crashes"
    fi
fi

# Notify if errors found
if [ "$NEW_ERRORS" -gt 0 ]; then
    MESSAGE="$NEW_ERRORS new errors detected"
    
    # Log notification
    logger -t maxregner-error "$MESSAGE"
    
    # Desktop notification
    if [ -n "$DISPLAY" ]; then
        notify-send "MaxRegner OS Errors" "$MESSAGE"
    fi
    
    # Email notification
    if command -v mail &>/dev/null; then
        echo "$MESSAGE" | mail -s "MaxRegner OS Errors" root@localhost
    fi
    
    exit 1
else
    echo "No new errors detected"
    exit 0
fi
ERRORNOTIFY

chmod +x /usr/local/bin/maxregner-error-notify

# Configure cron for error checking
cat > /etc/cron.d/maxregner-error-check << 'ERRORCRON'
# MaxRegner OS Error Check Cron

# Check for errors every hour
0 * * * * root /usr/local/bin/maxregner-error-notify >> /var/log/maxregner-error-check.log 2>&1

# Send daily error report
0 8 * * * root logwatch --service maxregner --output mail --mailto root@localhost --detail high

# Clean error logs weekly
0 3 * * 0 root find /var/log/maxregner/ -name "*.log" -mtime +30 -delete
ERRORCRON

# Enable and start services
systemctl enable apport 2>/dev/null || true
systemctl enable whoopsie 2>/dev/null || true
systemctl enable rsyslog 2>/dev/null || true
systemctl enable cron 2>/dev/null || true

# Start services
systemctl start apport 2>/dev/null || true
systemctl start whoopsie 2>/dev/null || true
systemctl start rsyslog 2>/dev/null || true

echo ""
echo "========================================"
echo "MaxRegner Error Reporting Complete!"
echo "========================================"
