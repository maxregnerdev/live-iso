#!/bin/bash
# MaxRegner OS - Multimedia Configuration Hook
# Configures complete multimedia support

set -e

echo "========================================"
echo "MaxRegner OS - Multimedia Hook"
echo "========================================"

# ============================================
# 1. INSTALL MULTIMEDIA CODECS
# ============================================

echo "[1/5] Installing multimedia codecs..."

# Install multimedia packages
apt-get install -y ffmpeg ffmpeg-extra libavcodec-extra libavdevice-extra \
    libavfilter-extra libavformat-extra libavresample-extra libavutil-extra \
    libpostproc-extra libswresample-extra libswscale-extra \
    gstreamer1.0-plugins-bad gstreamer1.0-plugins-ugly gstreamer1.0-libav \
    gstreamer1.0-plugins-good gstreamer1.0-plugins-base gstreamer1.0-tools \
    gstreamer1.0-x gstreamer1.0-alsa gstreamer1.0-pulseaudio \
    libgstreamer-plugins-bad1.0-0 libgstreamer-plugins-ugly1.0-0 \
    libgstreamer-plugins-good1.0-0 libgstreamer-plugins-base1.0-0 2>/dev/null || true

# Install VA-API and VDPAU
apt-get install -y libva2 libva-drm2 libva-x11-2 libva-glx2 \
    vainfo i965-va-driver-shaders intel-media-va-driver-non-free \
    libvdpau1 libvdpau-va-gl1 vdpauinfo 2>/dev/null || true

# Install Vulkan
apt-get install -y vulkan-tools libvulkan1 vulkan-icd-loader \
    mesa-vulkan-drivers libvulkan-intel libvulkan-radeon \
    libvulkan-amdgpu-pro 2>/dev/null || true

# ============================================
# 2. CONFIGURE FFMPEG
# ============================================

echo "[2/5] Configuring FFmpeg..."

# Create FFmpeg configuration
mkdir -p /etc/ffmpeg
cat > /etc/ffmpeg/ffmpeg.conf << 'FFMPEGCONF'
# MaxRegner OS FFmpeg Configuration

# FFmpeg options
ffmpeg_opts="-hide_banner -y"

# FFprobe options
ffprobe_opts="-hide_banner -show_format -show_streams"

# Codec settings
codec_opts="-c:v libx264 -c:a aac"

# Quality settings
quality_opts="-crf 23 -preset fast -tune film"

# Hardware acceleration
hwaccel_opts="-hwaccel auto -hwaccel_output_format auto"

# Threading
thread_opts="-threads 4"

# MaxRegner specific
maxregner_opts="-metadata title=MaxRegner\ OS -metadata copyright=MaxRegner\ OS"
FFMPEGCONF

# Create FFmpeg presets
mkdir -p /etc/ffmpeg/presets
cat > /etc/ffmpeg/presets/maxregner-h264.ffpreset << 'FFPRESET'
# MaxRegner OS H.264 Preset

vcodec=libx264
acodec=aac
crf=23
preset=fast
tune=film
x264-params=ref=4:bframes=4:scenecut=40:rc-lookahead=40
threads=4
profile=high
level=4.1
pix_fmt=yuv420p
movflags=+faststart
FFPRESET

# ============================================
# 3. CONFIGURE GSTREAMER
# ============================================

echo "[3/5] Configuring GStreamer..."

# Create GStreamer configuration
mkdir -p /etc/gstreamer-1.0
cat > /etc/gstreamer-1.0/gst-registry-1.0.scan << 'GSTCONF'
# MaxRegner OS GStreamer Registry Configuration

# Plugin paths
GST_PLUGIN_PATH=/usr/lib/x86_64-linux-gnu/gstreamer1.0
GST_PLUGIN_PATH_1_0=/usr/lib/x86_64-linux-gnu/gstreamer-1.0
GST_REGISTRY_SCAN=1

# Registry settings
GST_REGISTRY_FORK=0
GST_REGISTRY_SCAN=1
GST_REGISTRY_USE_ENV=0
GST_REGISTRY_PLUGIN_SCAN=1
GSTCONF

# Create GStreamer plugin configuration
mkdir -p /etc/gstreamer-1.0
cat > /etc/gstreamer-1.0/plugin-registry.bin << 'GSTPLUGIN'
# MaxRegner OS GStreamer Plugin Registry
# This file is auto-generated by GStreamer
# MaxRegner OS includes all available plugins
GSTPLUGIN

# ============================================
# 4. CONFIGURE VA-API
# ============================================

echo "[4/5] Configuring VA-API..."

# Create VA-API configuration
cat > /etc/libva.conf << 'VAPICONF'
# MaxRegner OS VA-API Configuration

# Driver configuration
LIBVA_DRIVER_NAME=iHD
LIBVA_DRIVERS_PATH=/usr/lib/x86_64-linux-gnu/dri

# Performance settings
LIBVA_TRACE=0
LIBVA_MESSAGING_LEVEL=0

# MaxRegner specific
LIBVA_MAX_THREADS=4
LIBVA_MEMORY_TYPE=0
VAPICONF

# Create VA-API driver configuration
mkdir -p /etc/libva
cat > /etc/libva/driver.conf << 'VADRIVERCONF'
# MaxRegner OS VA-API Driver Configuration

# Intel driver
i965_driver=iHD

# AMD driver
radeon_driver=r600

# NVIDIA driver
nouveau_driver=nouveau
VADRIVERCONF

# ============================================
# 5. CONFIGURE MULTIMEDIA PLAYERS
# ============================================

echo "[5/5] Configuring multimedia players..."

# Install multimedia players
apt-get install -y vlc vlc-plugin-access-extra vlc-plugin-fluidsynth \
    vlc-plugin-jack vlc-plugin-sampler vlc-plugin-sdl vlc-plugin-svg \
    vlc-plugin-video-output vlc-plugin-video-splitter vlc-plugin-visualization \
    mpv mpv-libs libmpv1 smplayer smplayer-l10n smplayer-themes \
    gnome-mpv mplayer mplayer-skins mplayer2 2>/dev/null || true

# Configure VLC
mkdir -p /etc/vlc/lua/extensions
cat > /etc/vlc/lua/extensions/maxregner.lua << 'VLCLUA'
-- MaxRegner OS VLC Extension

function descriptor()
    return {
        title = "MaxRegner OS Extension",
        version = "1.0",
        author = "MaxRegner Team",
        url = "https://maxregneros.com",
        shortdesc = "MaxRegner OS VLC Extension",
        description = "Adds MaxRegner OS specific functionality to VLC",
        capabilities = { "input-listener" }
    }
end

function activate()
    vlc.msg.info("MaxRegner OS VLC Extension activated")
end

function deactivate()
    vlc.msg.info("MaxRegner OS VLC Extension deactivated")
end

function input_changed()
    vlc.msg.info("Input changed")
end
VLCLUA

# Configure MPV
mkdir -p /home/maxregner/.config/mpv
cat > /home/maxregner/.config/mpv/mpv.conf << 'MPVCONF'
# MaxRegner OS MPV Configuration

# Video settings
vo=gpu
hwdec=auto
profile=gpu-hq

# Audio settings
ao=pulse
volume=100

# Subtitle settings
sub-auto=yes
sub-codepage=utf-8
sub-font="DejaVu Sans"
sub-font-size=50
sub-color=#ffffff
sub-shadow-color=#000000
sub-shadow-offset=2

# Playback settings
loop-file=no
shuffle=no
save-position-on-quit=yes

# Performance settings
cache=yes
cache-size=1024
cache-initial=25
cache-seek-min=25

# MaxRegner specific
input-ipc-server=/tmp/mpvsocket
keep-open=yes
heartbeat-cmd="echo 'MaxRegner OS MPV Heartbeat'"
MPVCONF

chown -R maxregner:maxregner /home/maxregner/.config/mpv

echo ""
echo "========================================"
echo "MaxRegner Multimedia Complete!"
echo "========================================"
