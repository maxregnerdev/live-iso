#!/bin/bash
# MaxRegner OS - Custom Scripts Configuration Hook
# Configures MaxRegner-specific custom scripts

set -e

echo "========================================"
echo "MaxRegner OS - Custom Scripts Hook"
echo "========================================"

# ============================================
# 1. CREATE CUSTOM SCRIPT DIRECTORIES
# ============================================

echo "[1/5] Creating custom script directories..."

mkdir -p /usr/local/bin/maxregner-scripts
mkdir -p /usr/local/lib/maxregner-scripts
mkdir -p /etc/maxregner/scripts
mkdir -p /var/lib/maxregner/scripts

# ============================================
# 2. CREATE SYSTEM SCRIPTS
# ============================================

echo "[2/5] Creating system scripts..."

# Create MaxRegner update script
cat > /usr/local/bin/maxregner-update << 'MAXUPDATE'
#!/bin/bash
# MaxRegner OS Update Script

set -e

echo "========================================"
echo "MaxRegner OS Update"
echo "========================================"
echo ""

# Check for root
if [ "$(id -u)" -ne 0 ]; then
    echo "Please run as root!"
    exit 1
fi

# Update package lists
echo "Updating package lists..."
apt-get update -y 2>/dev/null || true

# Upgrade packages
echo "Upgrading packages..."
apt-get upgrade -y 2>/dev/null || true

# Distro upgrade
echo "Performing distro upgrade..."
apt-get dist-upgrade -y 2>/dev/null || true

# Clean up
echo "Cleaning up..."
apt-get autoremove -y 2>/dev/null || true
apt-get autoclean -y 2>/dev/null || true

# Update initramfs
echo "Updating initramfs..."
update-initramfs -u 2>/dev/null || true

# Update GRUB
echo "Updating GRUB..."
update-grub 2>/dev/null || true

# Update MaxRegner specific packages
if [ -d /opt/maxregner ]; then
    echo "Updating MaxRegner packages..."
    cd /opt/maxregner && git pull 2>/dev/null || true
fi

echo ""
echo "Update complete!"
MAXUPDATE

chmod +x /usr/local/bin/maxregner-update

# Create MaxRegner cleanup script
cat > /usr/local/bin/maxregner-cleanup << 'MAXCLEANUP'
#!/bin/bash
# MaxRegner OS Cleanup Script

set -e

echo "========================================"
echo "MaxRegner OS Cleanup"
echo "========================================"
echo ""

# Check for root
if [ "$(id -u)" -ne 0 ]; then
    echo "Please run as root!"
    exit 1
fi

# Clean package cache
echo "Cleaning package cache..."
apt-get clean 2>/dev/null || true
apt-get autoclean 2>/dev/null || true

# Remove old kernels
echo "Removing old kernels..."
apt-get purge $(dpkg -l | awk '/^ii linux-image-*/ {print $2}' | grep -v $(uname -r)) 2>/dev/null || true

# Clean thumbnail cache
echo "Cleaning thumbnail cache..."
rm -rf /var/cache/thumbnailers/* 2>/dev/null || true
rm -rf /home/*/.cache/thumbnails/* 2>/dev/null || true

# Clean temporary files
echo "Cleaning temporary files..."
rm -rf /tmp/* 2>/dev/null || true
rm -rf /var/tmp/* 2>/dev/null || true

# Clean old logs
echo "Cleaning old logs..."
find /var/log -type f -name "*.log" -mtime +30 -delete 2>/dev/null || true
find /var/log -type f -name "*.gz" -mtime +30 -delete 2>/dev/null || true

# Clean old snap packages
echo "Cleaning old snap packages..."
snap list --all | awk '/disabled/ {print $1, $3}' | while read snapname revision; do
    snap remove "$snapname" --revision="$revision" 2>/dev/null || true
done

# Clean Docker
echo "Cleaning Docker..."
docker system prune -a -f 2>/dev/null || true

# Clean Flatpak
echo "Cleaning Flatpak..."
flatpak uninstall --unused 2>/dev/null || true

# Clean journal logs
echo "Cleaning journal logs..."
journalctl --vacuum-time=7d 2>/dev/null || true

# Clean systemd journals
echo "Cleaning systemd journals..."
journalctl --vacuum-size=100M 2>/dev/null || true

echo ""
echo "Cleanup complete!"
MAXCLEANUP

chmod +x /usr/local/bin/maxregner-cleanup

# Create MaxRegner backup script
cat > /usr/local/bin/maxregner-backup << 'MAXBACKUP'
#!/bin/bash
# MaxRegner OS Backup Script

set -e

echo "========================================"
echo "MaxRegner OS Backup"
echo "========================================"
echo ""

# Check for root
if [ "$(id -u)" -ne 0 ]; then
    echo "Please run as root!"
    exit 1
fi

# Check backup directory
BACKUP_DIR="/var/backups/maxregner"
mkdir -p "$BACKUP_DIR"

# Timestamp
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
BACKUP_FILE="$BACKUP_DIR/maxregner-backup-$TIMESTAMP.tar.gz"

echo "Creating backup: $BACKUP_FILE"

# Backup important directories
tar -czf "$BACKUP_FILE" \
    /etc \
    /home \
    /opt/maxregner \
    /usr/local/bin/maxregner-* \
    /usr/local/lib/maxregner-* \
    /var/lib/maxregner \
    --exclude=/home/*/.cache \
    --exclude=/home/*/.local/share/Trash \
    --exclude=/home/*/.thumbnails \
    --exclude=/var/cache \
    --exclude=/var/tmp \
    --exclude=/proc \
    --exclude=/sys \
    --exclude=/dev \
    2>/dev/null || true

# Verify backup
if [ -f "$BACKUP_FILE" ]; then
    SIZE=$(du -h "$BACKUP_FILE" | cut -f1)
    echo "Backup created: $BACKUP_FILE ($SIZE)"
else
    echo "Backup failed!"
    exit 1
fi

# Clean old backups
echo "Cleaning old backups..."
find "$BACKUP_DIR" -name "maxregner-backup-*.tar.gz" -mtime +30 -delete 2>/dev/null || true

echo ""
echo "Backup complete!"
MAXBACKUP

chmod +x /usr/local/bin/maxregner-backup

# ============================================
# 3. CREATE USER SCRIPTS
# ============================================

echo "[3/5] Creating user scripts..."

# Create user script directory
mkdir -p /home/maxregner/.local/bin

# Create MaxRegner welcome script
cat > /home/maxregner/.local/bin/maxregner-welcome << 'WELCOME'
#!/bin/bash
# MaxRegner OS Welcome Script

echo "=========================================="
echo "Welcome to MaxRegner OS!"
echo "=========================================="
echo ""
echo "System Information:"
echo "  OS: MaxRegner OS"
echo "  Kernel: $(uname -r)"
echo "  Hostname: $(hostname)"
echo "  User: $(whoami)"
echo ""
echo "Quick Commands:"
echo "  update         - Update the system"
echo "  cleanup        - Clean up the system"
echo "  backup         - Create a backup"
echo "  monitor        - Monitor system resources"
echo "  info           - Show system information"
echo ""
echo "Available Applications:"
echo "  Firefox       - Web browser"
echo "  LibreOffice   - Office suite"
echo "  GNOME Terminal - Terminal emulator"
echo "  Nautilus      - File manager"
echo ""
echo "Type 'help' for more information"
echo "=========================================="
WELCOME

chmod +x /home/maxregner/.local/bin/maxregner-welcome
chown maxregner:maxregner /home/maxregner/.local/bin/maxregner-welcome

# ============================================
# 4. CREATE DEVELOPMENT SCRIPTS
# ============================================

echo "[4/5] Creating development scripts..."

# Create development script directory
mkdir -p /usr/local/bin/maxregner-dev

# Create project setup script
cat > /usr/local/bin/maxregner-dev/setup-project << 'DEVSETUP'
#!/bin/bash
# MaxRegner OS Project Setup Script

set -e

if [ -z "$1" ]; then
    echo "Usage: maxregner-dev-setup-project <project-name> [template]"
    exit 1
fi

PROJECT_NAME="$1"
TEMPLATE="${2:-default}"
PROJECT_DIR="$HOME/projects/$PROJECT_NAME"

# Create project directory
mkdir -p "$PROJECT_DIR"
cd "$PROJECT_DIR"

# Create project structure
case "$TEMPLATE" in
    python)
        mkdir -p src tests docs build dist
        cat > README.md << 'PYREADME'
# $PROJECT_NAME

## Description

## Installation

## Usage
PYREADME
        cat > setup.py << 'PYSETUP'
from setuptools import setup, find_packages

setup(
    name="$PROJECT_NAME",
    version="0.1.0",
    packages=find_packages(),
    install_requires=[],
    entry_points={
        'console_scripts': [
            '$PROJECT_NAME=$PROJECT_NAME.main:main',
        ],
    },
)
PYSETUP
        ;;
    cpp)
        mkdir -p src include lib build
        cat > CMakeLists.txt << 'CMAKE'
cmake_minimum_required(VERSION 3.10)
project($PROJECT_NAME)

set(CMAKE_CXX_STANDARD 17)

add_executable($PROJECT_NAME src/main.cpp)
CMAKE
        cat > src/main.cpp << 'CPPMAIN'
#include <iostream>

int main() {
    std::cout << "Hello from $PROJECT_NAME!" << std::endl;
    return 0;
}
CPPMAIN
        ;;
    web)
        mkdir -p public src css js images
        cat > index.html << 'WEBINDEX'
<!DOCTYPE html>
<html>
<head>
    <title>$PROJECT_NAME</title>
</head>
<body>
    <h1>Welcome to $PROJECT_NAME</h1>
</body>
</html>
WEBINDEX
        ;;
    *)
        mkdir -p src docs build
        cat > README.md << 'DEFAULTREADME'
# $PROJECT_NAME

## Description
DEFAULTREADME
        ;;
esac

# Create .gitignore
cat > .gitignore << 'GITIGNORE'
# MaxRegner OS Git Ignore

# OS generated files
.DS_Store
Thumbs.db

# Editor directories
.idea/
.vscode/
*.swp
*.swo

# Build directories
build/
dist/
*.pyc
__pycache__/

# Logs
*.log
*.tmp

# Environment
.env
.env.local
.env.*.local

# Dependencies
node_modules/
vendor/
GITIGNORE

# Create Makefile
cat > Makefile << 'MAKEFILE'
# MaxRegner OS Makefile

.PHONY: all clean install test

all:
	@echo "Building $PROJECT_NAME"

clean:
	rm -rf build/ dist/

install:
	@echo "Installing $PROJECT_NAME"
	test:
	@echo "Testing $PROJECT_NAME"
MAKEFILE

echo "Project $PROJECT_NAME created with template: $TEMPLATE"
DEVSETUP

chmod +x /usr/local/bin/maxregner-dev/setup-project

# ============================================
# 5. CREATE SYSTEM INTEGRATION SCRIPTS
# ============================================

echo "[5/5] Creating system integration scripts..."

# Create system hook script
cat > /usr/local/bin/maxregner-hook-runner << 'HOOKRUNNER'
#!/bin/bash
# MaxRegner OS Hook Runner Script

set -e

HOOK_DIR="/workspace/github__maxregnerdev__live-iso/maxregner-os/hooks/live"

if [ -z "$1" ]; then
    echo "Usage: maxregner-hook-runner <hook-name>"
    echo "Available hooks:"
    ls "$HOOK_DIR"/*.chroot | xargs -n1 basename | sed 's/.chroot//' | sed 's/^[0-9]*-//'
    exit 1
fi

HOOK_NAME="$1"
HOOK_FILE="$HOOK_DIR/${HOOK_NAME}.chroot"

if [ ! -f "$HOOK_FILE" ]; then
    # Try with number prefix
    HOOK_FILE="$HOOK_DIR/$(ls "$HOOK_DIR"/*.chroot | grep "$HOOK_NAME" | head -1)"
fi

if [ ! -f "$HOOK_FILE" ]; then
    echo "Error: Hook '$HOOK_NAME' not found!"
    exit 1
fi

echo "Running hook: $(basename "$HOOK_FILE")"
chmod +x "$HOOK_FILE"
"$HOOK_FILE"

echo "Hook completed: $(basename "$HOOK_FILE")"
HOOKRUNNER

chmod +x /usr/local/bin/maxregner-hook-runner

echo ""
echo "========================================"
echo "MaxRegner Custom Scripts Complete!"
echo "========================================"
