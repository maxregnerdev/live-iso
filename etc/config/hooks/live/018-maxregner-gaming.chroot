
# MaxRegner user configuration
MAXREGNER_USER="${LIVE_USERNAME:-maxregner}"
MAXREGNER_HOME="/home/$MAXREGNER_USER"

#!/bin/bash
# MaxRegner OS - Gaming Support Configuration Hook
# Configures complete gaming environment

set -e

echo "========================================"
echo "MaxRegner OS - Gaming Support Hook"
echo "========================================"

# ============================================
# 1. INSTALL GAMING PLATFORMS
# ============================================

echo "[1/5] Installing gaming platforms..."

# Install Steam
apt-get install -y steam steam-launcher steam:i386 2>/dev/null || true

# Install Lutris
apt-get install -y lutris 2>/dev/null || true

# Install Wine
apt-get install -y wine wine32 wine64 winetricks wine-gecko wine-mono 2>/dev/null || true

# ============================================
# 2. CONFIGURE WINE
# ============================================

echo "[2/5] Configuring Wine..."

# Create Wine configuration
mkdir -p /home/$MAXREGNER_USER/.wine/drive_c/windows
mkdir -p /home/$MAXREGNER_USER/.wine/dosdevices

cat > /home/$MAXREGNER_USER/.wine/config << 'WINEOF'
[wine]
Windows = win10
SysDir = c:\\windows\\system32
TempDir = c:\\windows\\temp
Path = c:\\windows\\system32;c:\\windows;c:\\windows\\system;c:\\;c:\\windows\\command.com
GraphicsDriver = opengl

[Version]
Windows = win10

[Drive C]
Path = /home/$MAXREGNER_USER/.wine/drive_c
Type = hd
Label = MS-DOS
Filesystem = win32

[winegstream]
Enabled = 1
WINEOF

chown -R "$MAXREGNER_USER:$MAXREGNER_USER" /home/$MAXREGNER_USER/.wine

# ============================================
# 3. CONFIGURE STEAM
# ============================================

echo "[3/5] Configuring Steam..."

# Create Steam configuration
mkdir -p /home/$MAXREGNER_USER/.steam/steam
mkdir -p /home/$MAXREGNER_USER/.steam/root
mkdir -p /home/$MAXREGNER_USER/.steam/steam/steamapps

cat > /home/$MAXREGNER_USER/.steam/steam/SteamAppData.vdf << 'STEAMOF'
"AppState"
{
	"appid_10" "0"
	"appid_20" "0"
	"appid_30" "0"
}
STEAMOF

# Steam launch options
cat > /home/$MAXREGNER_USER/.steam/steam/SteamAppUserData.vdf << 'STEAMOF'
"UserLocalConfigStore"
{
	"SteamID64" "76561197960287930"
	"LaunchCount" "1"
	"LastLaunchTime" "1609459200"
}
STEAMOF

chown -R "$MAXREGNER_USER:$MAXREGNER_USER" /home/$MAXREGNER_USER/.steam

# ============================================
# 4. INSTALL GAMING UTILITIES
# ============================================

echo "[4/5] Installing gaming utilities..."

# Install gaming utilities
apt-get install -y mangohud gamemode libgamemodeauto0 \
    corectrl libcorectrl0 vkbasalt vkcube vulkan-tools \
    glmark2 glxinfo glxgears 2>/dev/null || true

# Configure GameMode
mkdir -p /etc
cat > /etc/gamemode.ini << 'GAMEOF'
[gamemode]
# Enable GameMode by default
enabled=1

# CPU governor settings
cpu_gov=performance

# GPU settings
gpu_gov=performance

# I/O priority
ioprio=0

# Nice level
nice=-20

# Memory settings
mem_lock=1

# Network settings
net_prio=1
GAMEOF

# Configure MangoHud
mkdir -p /etc/MangoHud
cat > /etc/MangoHud/MangoHud.conf << 'MANGOOF'
[preset]
preset=1

[appearance]
background_alpha=180
font_size=18
font_color=0xffffffff
background_color=0x000000ff

[engine]
enabled=true
no_small_fonts=false
output_file=
position=top-left
cpu_stats=true
gpu_stats=true
ram_stats=true
fps_stats=true
frame_timing_stats=false

[input]
toggle_hud=Shift_R+F12
toggle_hud_position=Shift_R+F11
toggle_log=Shift_R+F10
reload_cfg=Shift_R+F9
MANGOOF

# ============================================
# 5. CONFIGURE VULKAN AND GRAPHICS
# ============================================

echo "[5/5] Configuring Vulkan and graphics..."

# Install Vulkan drivers
apt-get install -y vulkan-tools libvulkan1 vulkan-icd-loader \
    mesa-vulkan-drivers intel-opencl-icd nvidia-opencl-icd \
    ocl-icd-opencl-dev 2>/dev/null || true

# Configure Vulkan
mkdir -p /etc/vulkan/icd.d
cat > /etc/vulkan/icd.d/10_maxregner.json << 'VULKANOF'
{
    "file_format_version" : "1.0.0",
    "ICD" : {
        "library_path" : "/usr/share/vulkan/icd.d/radeon_icd.x86_64.json",
        "api_version" : "1.3.0"
    }
}
VULKANOF

# Configure VA-API for hardware video decoding
mkdir -p /etc/environment.d
cat > /etc/environment.d/99-maxregner-gaming.conf << 'VAEOF'
# MaxRegner OS Gaming Environment
LIBVA_DRIVER_NAME=iHD
MOZ_DISABLE_RDD_SANDBOX=1
MESA_GL_VERSION_OVERRIDE=4.6
MESA_GLSL_VERSION_OVERRIDE=460
VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/radeon_icd.x86_64.json
GAMEDEVMODE=perform
GAMEDEVMOUSE=0
GAMEDEVKEYB=0
VAEOF

# Create gaming scripts
mkdir -p /usr/local/games
cat > /usr/local/games/run-game << 'SCRIPT'
#!/bin/bash
# MaxRegner OS Game Launcher Script
echo "Launching game with optimized settings..."
gamemoderun mangohud $@
SCRIPT

chmod +x /usr/local/games/run-game

echo ""
echo "========================================"
echo "MaxRegner Gaming Support Complete!"
echo "========================================"
