#!/bin/bash

set -e

# MaxRegner user configuration
MAXREGNER_USER="${LIVE_USERNAME:-maxregner}"

MAXREGNER_HOME="/home/$MAXREGNER_USER"

# MaxRegner OS - Messaging Applications Configuration Hook
# Configures comprehensive messaging support
echo "========================================"
echo "MaxRegner OS - Messaging Hook"
echo "========================================"

# ============================================
# 1. INSTALL MESSAGING APPLICATIONS
# ============================================

echo "[1/5] Installing messaging applications..."

# Install Pidgin
apt-get install -y pidgin pidgin-data pidgin-libnotify pidgin-otr \
    pidgin-plugin-pack pidgin-musicmessaging pidgin-guifications \
    pidgin-latex pidgin-encryption pidgin-hotkeys 2>/dev/null || true

# Install Empathy
apt-get install -y empathy empathy-common 2>/dev/null || true

# Install Telegram Desktop
apt-get install -y telegram-desktop 2>/dev/null || true

# Install Discord
apt-get install -y discord 2>/dev/null || true

# Install HexChat (IRC)
apt-get install -y hexchat hexchat-common hexchat-plugins 2>/dev/null || true

# Install Quassel (IRC)
apt-get install -y quassel quassel-client quassel-core 2>/dev/null || true

# Install Matrix clients
apt-get install -y element-desktop riot-web 2>/dev/null || true

# ============================================
# 2. CONFIGURE PIDGIN
# ============================================
echo "[2/5] Configuring Pidgin..."

# Create Pidgin configuration
mkdir -p /home/$MAXREGNER_USER/.purple
cat > /home/$MAXREGNER_USER/.purple/prefs.xml << 'PIDGINPREFS'
<?xml version='1.0' encoding='UTF-8'?>

<pref version='1'>
	<preference name='away' type='string' value='I am away'/>
	<preference name='away_time' type='int' value='0'/>
	<preference name='auto_reconnect' type='bool' value='1'/>
	<preference name='buddy_icon' type='string' value=''/>
	<preference name='conversations' type='list' value=''>
		<item type='string' value='gtk'/>
	</preference>
	<preference name='debug_enabled' type='bool' value='0'/>
	<preference name='default_format' type='string' value='txt'/>
	<preference name='default_smiley' type='string' value='theme'/>
	<preference name='docklet' type='list' value=''>
		<item type='bool' value='1'/>
		<item type='bool' value='1'/>
		<item type='bool' value='1'/>
	</preference>
	<preference name='font' type='list' value=''>
		<item type='string' value='Liberation Sans 10'/>
	</preference>
	<preference name='idle_reporting' type='bool' value='1'/>
	<preference name='logging' type='list' value=''>
		<item type='bool' value='1'/>
		<item type='string' value='html'/>
		<item type='bool' value='1'/>
	</preference>
	<preference name='minimized' type='bool' value='0'/>
	<preference name='network' type='list' value=''>
		<item type='bool' value='1'/>
		<item type='int' value='0'/>
		<item type='bool' value='0'/>
		<item type='bool' value='0'/>
		<item type='bool' value='0'/>
	</preference>
	<preference name='notifications' type='list' value=''>
		<item type='bool' value='1'/>
		<item type='bool' value='1'/>
		<item type='bool' value='1'/>
		<item type='bool' value='1'/>
	</preference>
	<preference name='plugins' type='list' value=''>
		<item type='string' value='autoaccept'/>
		<item type='string' value='cap'/>
		<item type='string' value='gestures'/>
		<item type='string' value='history'/>
		<item type='string' value='idle'/>
		<item type='string' value='joinpart'/>
		<item type='string' value='log_reader'/>
		<item type='string' value='musicmessaging'/>
		<item type='string' value='notify'/>
		<item type='string' value='offlinemsg'/>
		<item type='string' value='psychic'/>
		<item type='string' value='ssl'/>
		<item type='string' value='typingnotification'/>
		<item type='string' value='xtify'/>
	</preference>
	<preference name='sound' type='list' value=''>
		<item type='bool' value='1'/>
		<item type='string' value=''/>
		<item type='string' value=''/>
		<item type='bool' value='1'/>
		<item type='bool' value='1'/>
		<item type='bool' value='1'/>
		<item type='string' value=''/>
	</preference>
	<preference name='status' type='list' value=''>
		<item type='bool' value='1'/>
		<item type='int' value='0'/>
		<item type='bool' value='1'/>
		<item type='bool' value='1'/>
		<item type='bool' value='1'/>
		<item type='bool' value='0'/>
		<item type='int' value='0'/>
		<item type='bool' value='0'/>
	</preference>
	<preference name='theme' type='string' value='MaxRegner'/>
	<preference name='timestamp' type='int' value='1609459200'/>
	<preference name='timestamp_format' type='string' value='%Y-%m-%d %H:%M:%S'/>
	<preference name='version' type='string' value='2.14.0'/>
</pref>
PIDGINPREFS
n
cat > /home/$MAXREGNER_USER/.purple/accounts.xml << 'PIDGINACCOUNTS'
<?xml version='1.0' encoding='UTF-8'?>

<account version='1.0'>
	<protocol>prpl-irc</protocol>
	<name>MaxRegner@irc.maxregneros.com</name>
	<settings>
		<setting name='server' type='string'>
			<value>irc.maxregneros.com</value>
		</setting>
		<setting name='port' type='int'>
			<value>6667</value>
		</setting>
		<setting name='username' type='string'>
			<value>MaxRegner</value>
		</setting>
		<setting name='realname' type='string'>
			<value>MaxRegner OS User</value>
		</setting>
		<setting name='password' type='string'>
			<value></value>
		</setting>
		<setting name='autojoin' type='list'>
			<item>
				<value>#maxregner</value>
			</item>
			<item>
				<value>#maxregner-support</value>
			</item>
		</setting>
		<setting name='auto_connect' type='bool'>
			<value>true</value>
		</setting>
		<setting name='ssl' type='bool'>
			<value>false</value>
		</setting>
		<setting name='ssl_certcheck' type='bool'>
			<value>true</value>
		</setting>
	</settings>
	<settings ui='gtk-gaim'>
		<setting name='auto-login' type='bool'>
			<value>true</value>
		</setting>
		<setting name='buddyicon' type='string'>
			<value></value>
		</setting>
		<setting name='custom_buddyicon' type='bool'>
			<value>false</value>
		</setting>
		<setting name='enabled' type='bool'>
			<value>true</value>
		</setting>
	</settings>
	<current_error type='string'></current_error>
	<connect_server>irc.maxregneros.com</connect_server>
	<prpl>prpl-irc</prpl>
	<proxy></proxy>
	<remember_pass>0</remember_pass>
	<buddy_icon></buddy_icon>
	<public_name>MaxRegner OS User</public_name>
	<user_info></user_info>
	<status type='int'>0</status>
	<idle type='int'>0</idle>
</account>
PIDGINACCOUNTS

chown -R "$MAXREGNER_USER" "$MAXREGNER_USER" /home/$MAXREGNER_USER/.purple

# ============================================
# 3. CONFIGURE TELEGRAM
# ============================================
echo "[3/5] Configuring Telegram..."

# Create Telegram configuration
mkdir -p /home/$MAXREGNER_USER/.config/Telegram
cat > /home/$MAXREGNER_USER/.config/Telegram/config << 'TELEGRAMCONF'
# MaxRegner OS Telegram Configuration

[General]
language=en
scale=1.0
theme=maxregner

[Appearance]
font_size=14
font_family=Liberation Sans
message_font_size=14
message_font_family=Liberation Sans

[Notifications]
enable_sound=true
enable_vibration=true
desktop_notifications=true

[Privacy]
disable_contacts_join=true
disable_phone_number_join=true

[Security]
use_password=false
encrypt_local_messages=true

[Connection]
use_proxy=false
proxy_type=0
TELEGRAMCONF

chown -R "$MAXREGNER_USER" "$MAXREGNER_USER" /home/$MAXREGNER_USER/.config/Telegram

# ============================================
# 4. CONFIGURE DISCORD
# ============================================
echo "[4/5] Configuring Discord..."

# Create Discord configuration
mkdir -p /home/$MAXREGNER_USER/.config/discord
cat > /home/$MAXREGNER_USER/.config/discord/settings.json << 'DISCORDCONF'
{
  "APPEARANCE": {
    "theme": "dark",
    "developer_mode": false,
    "message_display_compact": false,
    "show_current_game": true,
    "streamer_mode": false
  },
  "NOTIFICATIONS": {
    "enable": true,
    "sound": true,
    "flash_taskbar": true,
    "notify_friends_online": true,
    "mute_all": false
  },
  "VOICE": {
    "input_device": "default",
    "output_device": "default",
    "input_volume": 100,
    "output_volume": 100,
    "input_sensitivity": 50,
    "echo_cancellation": true,
    "noise_suppression": true
  },
  "TEXT": {
    "font_scale": 1.0,
    "font": "Liberation Sans",
    "chat_font_scale": 1.0,
    "chat_font": "Liberation Sans",
    "message_grouping": true,
    "render_embeds": true,
    "render_reactions": true
  },
  "KEYBINDINGS": {
    "push_to_talk": "KeyM",
    "mute": "KeyCtrl+Shift+M",
    "deafen": "KeyCtrl+Shift+D",
    "toggle_overlay": "KeyAlt+Tab"
  },
  "LOCALIZATION": {
    "language": "en",
    "timezone": "America/New_York"
  },
  "MAXREGNER": {
    "enabled": true,
    "custom_theme": true,
    "branding": "MaxRegner OS"
  }
}
DISCORDCONF

chown -R "$MAXREGNER_USER" "$MAXREGNER_USER" /home/$MAXREGNER_USER/.config/discord

# ============================================
# 5. CONFIGURE IRC CLIENTS
# ============================================
echo "[5/5] Configuring IRC clients..."

# Configure HexChat
mkdir -p /home/$MAXREGNER_USER/.config/hexchat
cat > /home/$MAXREGNER_USER/.config/hexchat/hexchat.conf << 'HEXCHATCONF'
# MaxRegner OS HexChat Configuration

[stamp]
timestamp_format = [%H:%M:%S]

[text]
font = Liberation Mono 10
font_main = Liberation Sans 10

[colors]
text_background = #1a1a2e
text_foreground = #eaeaea

[settings]
away_auto_unmark = 1
away_check = 1
away_nick_suffix = (away)
away_reason = I am away
away_time = 0
auto_copy_to_clipboard = 1
auto_join_on_invite = 1
auto_log = 1
auto_reconnect = 1
auto_reconnect_delay = 10
auto_reconnect_on_kick = 1

[servers]
server = irc.maxregneros.com/6667
server = irc.libera.chat/6667

[channels]
channel = #maxregner
auto_join = 1
channel = #maxregner-support
auto_join = 1
HEXCHATCONF

chown -R "$MAXREGNER_USER" "$MAXREGNER_USER" /home/$MAXREGNER_USER/.config/hexchat

# Configure Quassel
mkdir -p /home/$MAXREGNER_USER/.config/quassel-irc.org
cat > /home/$MAXREGNER_USER/.config/quassel-irc.org/quasselconfig << 'QUASSELCONF'
[General]
Identity=MaxRegner
RealName=MaxRegner OS User

[Networks]
Name=MaxRegner
Server=irc.maxregneros.com:6667
AutoConnect=true

[Channels]
Network=MaxRegner
Channel=#maxregner
AutoJoin=true

Channel=#maxregner-support
AutoJoin=true
QUASSELCONF

chown -R "$MAXREGNER_USER" "$MAXREGNER_USER" /home/$MAXREGNER_USER/.config/quassel-irc.org

echo ""
echo "========================================"
echo "MaxRegner Messaging Complete!"
echo "========================================"
