#!/bin/bash
# MaxRegner OS - Backup System Configuration Hook
# Configures comprehensive backup solutions

set -e

echo "========================================"
echo "MaxRegner OS - Backup System Hook"
echo "========================================"

# ============================================
# 1. INSTALL BACKUP TOOLS
# ============================================

echo "[1/5] Installing backup tools..."

# Install backup packages
apt-get install -y borgbackup borgmatic restic duplicity \
    rsync rclone deja-dup timeshift 2>/dev/null || true

# ============================================
# 2. CONFIGURE BORG
# ============================================

echo "[2/5] Configuring Borg..."

# Install Borg
apt-get install -y borgbackup borgmatic 2>/dev/null || true

# Create Borg configuration
mkdir -p /etc/borg
cat > /etc/borg/borg.conf << 'BORGCONF'
# MaxRegner OS Borg Configuration

[general]
# Repository location
repository = /var/backups/borg/{hostname}

# Encryption
encryption = repokey-blake2

# Compression
compression = lz4

# Archive name format
archive_name_format = {hostname}-{now:%Y-%m-%d_%H:%M:%S}

# Retention policy
keep_hourly = 24
keep_daily = 7
keep_weekly = 4
keep_monthly = 12
keep_yearly = 2

# Prune settings
prune_keep_hourly = 24
prune_keep_daily = 7
prune_keep_weekly = 4
prune_keep_monthly = 12
prune_keep_yearly = 2
BORGCONF

# Create Borgmatic configuration
mkdir -p /etc/borgmatic
cat > /etc/borgmatic/config.yaml << 'BORGMATICCONF'
# MaxRegner OS Borgmatic Configuration

location:
    source_directories:
        - /home
        - /etc
        - /var
        - /opt
    repositories:
        - /var/backups/borg/{hostname}
    exclude_patterns:
        - /home/*/.cache
        - /home/*/.local/share/Trash
        - /var/cache
        - /var/tmp
        - /var/lib/docker

storage:
    encryption_passcommand: "cat /etc/borg/passphrase"
    compression: lz4

retention:
    keep_hourly: 24
    keep_daily: 7
    keep_weekly: 4
    keep_monthly: 12
    keep_yearly: 2

consistency:
    checks:
        - repository
        - archives
    check_last: 3
    prefix: borg-check-
BORGMATICCONF

# ============================================
# 3. CONFIGURE RESTIC
# ============================================

echo "[3/5] Configuring Restic..."

# Install Restic
apt-get install -y restic 2>/dev/null || true

# Create Restic configuration
mkdir -p /etc/restic
cat > /etc/restic/config << 'RESTICCONF'
# MaxRegner OS Restic Configuration

# Repository location
REPOSITORY=/var/backups/restic

# Password file
PASSWORD_FILE=/etc/restic/passphrase

# Environment variables
RESTIC_PASSWORD_COMMAND="cat /etc/restic/passphrase"
TMPDIR=/tmp

# Backup settings
BACKUP_DIRS="/home /etc /var /opt"
EXCLUDE_FILE=/etc/restic/exclude

# Retention policy
RESTIC_KEEP_DAILY=7
RESTIC_KEEP_WEEKLY=4
RESTIC_KEEP_MONTHLY=12
RESTIC_KEEP_YEARLY=2
RESTIC_KEEP_LAST=5

# Performance
RESTIC_CACHE_DIR=/var/cache/restic
RESTIC_PACK_SIZE=10
RESTIC_COMPRESSION=auto
RESTICCONF

# Create Restic exclude file
cat > /etc/restic/exclude << 'RESTICEXCLUDE'
# MaxRegner OS Restic Exclude Patterns

# Cache directories
/home/*/.cache
/home/*/.local/share/Trash
/var/cache
/var/tmp

# Temporary files
/tmp
/var/tmp

# Docker
/var/lib/docker

# Virtual machines
/var/lib/libvirt

# Logs
/var/log

# System
/proc
/sys
/dev
RESTICEXCLUDE

# ============================================
# 4. CONFIGURE RSYNC
# ============================================

echo "[4/5] Configuring Rsync..."

# Install Rsync
apt-get install -y rsync 2>/dev/null || true

# Configure Rsync
cat > /etc/rsyncd.conf << 'RSYNCCONF'
# MaxRegner OS Rsync Configuration

# Global settings
uid = root
gid = root
use chroot = true
max connections = 10
timeout = 600
port = 873

# Module definitions
[home]
    path = /home
    comment = Home directories
    read only = false
    list = true
    uid = root
    gid = root
    auth users = maxregner
    secrets file = /etc/rsyncd.secrets

[etc]
    path = /etc
    comment = System configuration
    read only = true
    list = true
    uid = root
    gid = root
    auth users = maxregner
    secrets file = /etc/rsyncd.secrets

[backups]
    path = /var/backups
    comment = Backup storage
    read only = false
    list = true
    uid = root
    gid = root
    auth users = maxregner
    secrets file = /etc/rsyncd.secrets
RSYNCCONF

# Create Rsync secrets
cat > /etc/rsyncd.secrets << 'RSYNCSECRETS'
# MaxRegner OS Rsync Secrets
# Format: username:password

maxregner:maxregner-backup-password
RSYNCSECRETS

chmod 600 /etc/rsyncd.secrets

# ============================================
# 5. CONFIGURE TIMESHIFT
# ============================================

echo "[5/5] Configuring Timeshift..."

# Install Timeshift
apt-get install -y timeshift 2>/dev/null || true

# Configure Timeshift
cat > /etc/timeshift/timeshift.json << 'TIMESHIFTJSON'
{
    "backup_device_uuid": "",
    "btrfs_mode": false,
    "exclude": [
        "/dev/*",
        "/proc/*",
        "/sys/*",
        "/tmp/*",
        "/run/*",
        "/mnt/*",
        "/media/*",
        "/lost+found",
        "/home/*/.cache",
        "/home/*/.local/share/Trash",
        "/var/cache",
        "/var/tmp",
        "/var/lib/docker",
        "/var/lib/libvirt"
    ],
    "include": null,
    "snapshot_device": "/dev/sda1",
    "snapshot_excludes": null,
    "snapshot_includes": null,
    "snapshots": {
        "2024-01-01_00-00-00": {
            "path": "",
            "device": "",
            "uuid": ""
        }
    },
    "tags": [],
    "users": {
        "maxregner": {
            "enabled": true,
            "groups": ["sudo"]
        }
    },
    "schedule": {
        "daily": {
            "enabled": true,
            "keep": 7
        },
        "weekly": {
            "enabled": true,
            "keep": 4
        },
        "monthly": {
            "enabled": true,
            "keep": 12
        },
        "boot": {
            "enabled": true,
            "keep": 2
        }
    },
    "script": {
        "pre": null,
        "post": null
    },
    "btrfs_size": "",
    "rsync_flags": "-a --delete --xattrs --acls --one-file-system -X",
    "stop_cron": false,
    "backup_tool": "rsync",
    "selected_delete": false,
    "delete_id": ""
}
TIMESHIFTJSON

# Create backup directories
mkdir -p /var/backups/borg
mkdir -p /var/backups/restic
mkdir -p /var/backups/rsync
chmod 775 /var/backups
chmod 775 /var/backups/*

# Create backup scripts
mkdir -p /usr/local/bin/maxregner-backup
cat > /usr/local/bin/maxregner-backup/daily.sh << 'BACKUPSCRIPT'
#!/bin/bash
# MaxRegner OS Daily Backup Script

set -e

echo "Starting daily backup..."

# Borg backup
if command -v borg &>/dev/null; then
    echo "Running Borg backup..."
    borg create --stats --progress \
        /var/backups/borg/{hostname}-{now:%Y-%m-%d_%H:%M:%S} \
        /home /etc /var /opt \
        --exclude /home/*/.cache \
        --exclude /home/*/.local/share/Trash \
        --exclude /var/cache \
        --exclude /var/tmp
    
    # Prune old backups
    borg prune --stats \
        /var/backups/borg/{hostname} \
        --keep-hourly 24 \
        --keep-daily 7 \
        --keep-weekly 4 \
        --keep-monthly 12
fi

# Restic backup
if command -v restic &>/dev/null; then
    echo "Running Restic backup..."
    export RESTIC_PASSWORD=$(cat /etc/restic/passphrase)
    restic backup \
        /home /etc /var /opt \
        --exclude-file=/etc/restic/exclude \
        --host maxregner
    
    # Prune old backups
    restic forget \
        --keep-daily 7 \
        --keep-weekly 4 \
        --keep-monthly 12 \
        --keep-yearly 2 \
        --prune
fi

echo "Daily backup completed!"
BACKUPSCRIPT

chmod +x /usr/local/bin/maxregner-backup/daily.sh

# Enable and start services
systemctl enable rsync 2>/dev/null || true
systemctl start rsync 2>/dev/null || true

echo ""
echo "========================================"
echo "MaxRegner Backup System Complete!"
echo "========================================"
