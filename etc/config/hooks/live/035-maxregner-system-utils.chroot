#!/bin/bash

set -e

# MaxRegner user configuration
MAXREGNER_USER="${LIVE_USERNAME:-maxregner}"

MAXREGNER_HOME="/home/$MAXREGNER_USER"

# MaxRegner OS - System Utilities Configuration Hook
# Configures comprehensive system utility support
echo "========================================"
echo "MaxRegner OS - System Utilities Hook"
echo "========================================"

# ============================================
# 1. INSTALL SYSTEM UTILITIES
# ============================================

echo "[1/5] Installing system utilities..."

# Install system monitoring and information tools
apt-get install -y neofetch screenfetch inxi hardinfo \
    lshw dmidecode cpuid lscpu hwinfo 2>/dev/null || true

# Install system management tools
apt-get install -y sysv-rc-conf chkconfig bootchart \
    sysvinit-utils upstart file-rc 2>/dev/null || true

# Install hardware tools
apt-get install -y lm-sensors psensor fancontrol hddtemp \
    smartmontools smart-notifier gsmartcontrol 2>/dev/null || true

# Install performance tools
apt-get install -y sysstat iostat mpstat sar collectl vmstat \
    dstat iftop nethogs bmon 2>/dev/null || true

# Install compression tools
apt-get install -y p7zip p7zip-full p7zip-rar unrar-free \
    zip unzip arj cabextract lzma xz-utils zstd 2>/dev/null || true

# ============================================
# 2. CONFIGURE NEOFETCH
# ============================================

echo "[2/5] Configuring Neofetch..."

# Create Neofetch configuration
mkdir -p /home/$MAXREGNER_USER/.config/neofetch
cat > /home/$MAXREGNER_USER/.config/neofetch/config.conf << 'NEOFETCHCONF'
# MaxRegner OS Neofetch Configuration

# General settings
loop=false
refresh_rate=1

# Image settings
image_source="wallpaper"
image_backend="w3m"
image_cache_dir="/home/$MAXREGNER_USER/.cache/neofetch"
image_size="auto"
image_position="top left"
image_offset="0px 0px"

# ASCII art
ascii_distro="MaxRegner"
ascii_colors=(#1a1a2e #eaeaea)
ascii_bold=false

# Information
info="OS Kernel Uptime Packages Shell Resolution DE WM Theme Icons Terminal Font CPU GPU Memory"

# Color settings
colors=(#1a1a2e #eaeaea #f81ce5 #00ff00 #ffff00 #0000ff #ff00ff #00ffff)

# Separator
separator="-"
separator_color="#f81ce5"

# MaxRegner specific
maxregner=true
custom_ascii="
       _____ _____ _   _ _   _ _____ _____ ____
      |_   _/ ____| | | | \ | |_   _| ____/ ___|
        | | |  _| | | | |  \| | | | |  _| \___ \
        | | | |___| |_| | |\  | | | | | |___ ___) |
        |_| |_____|\___/|_| \_| |_| |_| |____|____/
"
NEOFETCHCONF

chown -R "$MAXREGNER_USER" "$MAXREGNER_USER" /home/$MAXREGNER_USER/.config/neofetch

# ============================================
# 3. CONFIGURE INXI
# ============================================

echo "[3/5] Configuring Inxi..."

# Create Inxi configuration
mkdir -p /home/$MAXREGNER_USER/.config/inxi
cat > /home/$MAXREGNER_USER/.config/inxi/inxi.conf << 'INXICONF'
# MaxRegner OS Inxi Configuration

# Output settings
--output=screen
--no-sensors
--no-ip
--no-host
--no-user
--no-updates
--no-recommends

# Verbosity
--verbosity=7
--debug=0
--filter=1

# Display settings
--display=short
--color=2
--no-color

# MaxRegner specific
--sysinfo=1
--basic=0
--full=0
--extra=1
INXICONF

chown -R "$MAXREGNER_USER" "$MAXREGNER_USER" /home/$MAXREGNER_USER/.config/inxi

# ============================================
# 4. CONFIGURE SENSORS
# ============================================

echo "[4/5] Configuring sensors..."

# Configure lm-sensors
mkdir -p /etc
cat > /etc/sensors3.conf << 'SENSORSCONF'
# MaxRegner OS Sensors Configuration

# Chip drivers
chip "coretemp-*"
chip "k10temp-*"
chip "radeon-*"
chip "nouveau-*"
chip "nct6775-*"
chip "it87-*"

# Temperature settings
set coretemp-* temp1_input 0
set coretemp-* temp1_max 100
set coretemp-* temp1_crit 105
set coretemp-* temp1_crit_alarm 1

set k10temp-* temp1_input 0
set k10temp-* temp1_max 70
set k10temp-* temp1_crit 90
set k10temp-* temp1_crit_alarm 1

# Fan settings
set fan1_min 1000
set fan1_max 5000
set fan1_start_pwm 100
set fan1_stop_pwm 0

# Voltage settings
set in0_min 0.8
set in0_max 1.5
set in1_min 1.0
set in1_max 2.0

# MaxRegner specific
set temp1_beep 0
set temp1_beep_alarm 0
SENSORSCONF

# Configure fancontrol
mkdir -p /etc
cat > /etc/fancontrol << 'FANCONTROLCONF'
# MaxRegner OS Fan Control Configuration

INTERVAL=10
DEVPATH=hwmon0=devices/platform/coretemp.0 hwmon1=devices/platform/nct6775.656
DEVNAME=hwmon0=coretemp hwmon1=nct6775
FCTEMPS=hwmon0/pwm1=hwmon0/temp1_input hwmon1/pwm1=hwmon1/temp1_input
FCFANS=hwmon0/pwm1=hwmon0/fan1_input hwmon1/pwm1=hwmon1/fan1_input
MINTEMP=hwmon0/pwm1=40 hwmon1/pwm1=40
MAXTEMP=hwmon0/pwm1=70 hwmon1/pwm1=70
MINSTART=hwmon0/pwm1=150 hwmon1/pwm1=150
MINSTOP=hwmon0/pwm1=100 hwmon1/pwm1=100
MINPWM=hwmon0/pwm1=0 hwmon1/pwm1=0
MAXPWM=hwmon0/pwm1=255 hwmon1/pwm1=255
FANCONTROLCONF

# ============================================
# 5. CONFIGURE SYSTEM SCRIPTS
# ============================================

echo "[5/5] Configuring system scripts..."

# Create system utility scripts
mkdir -p /usr/local/bin/maxregner-utils
cat > /usr/local/bin/maxregner-utils/system-info << 'SYSINFO'
# MaxRegner OS System Information Script

echo "========================================"
echo "MaxRegner OS System Information"
echo "========================================"
echo ""

# OS information
echo "OS Information:"
echo "  Distribution: MaxRegner OS"
echo "  Kernel: $(uname -r)"
echo "  Architecture: $(uname -m)"
echo "  Hostname: $(hostname)"
echo ""

# CPU information
echo "CPU Information:"
echo "  Model: $(grep -m 1 'model name' /proc/cpuinfo | cut -d: -f2 | xargs)"
echo "  Cores: $(nproc)"
echo "  Frequency: $(grep -m 1 'cpu MHz' /proc/cpuinfo | cut -d: -f2 | xargs) MHz"
echo "  Vendor: $(grep -m 1 'vendor_id' /proc/cpuinfo | cut -d: -f2 | xargs)"
echo ""

# Memory information
echo "Memory Information:"
free -h | awk '/^Mem:/ {print "  Total: " $2 "\n  Used: " $3 "\n  Free: " $4 "\n  Available: " $7}'
echo ""

# Disk information
echo "Disk Information:"
df -h | awk 'NR==1 || /^\/dev\// {printf "  %s %s %s %s\n", $1, $4, $5, $6}'
echo ""

# Network information
echo "Network Information:"
ip -br addr show | awk '{print "  " $1 " - " $3}'
echo ""

# Graphics information
echo "Graphics Information:"
if lspci | grep -q "NVIDIA"; then
    echo "  GPU: NVIDIA $(lspci | grep NVIDIA | head -1 | cut -d: -f3 | xargs)"
elif lspci | grep -q "AMD\|Radeon"; then
    echo "  GPU: AMD $(lspci | grep -i amd | head -1 | cut -d: -f3 | xargs)"
elif lspci | grep -q "Intel"; then
    echo "  GPU: Intel $(lspci | grep Intel | head -1 | cut -d: -f3 | xargs)"
fi
echo ""

# Temperature information
if command -v sensors &>/dev/null; then
    echo "Temperature Information:"
    sensors | grep -E "Package id|Core [0-9]+|temp1" | head -5 | awk '{print "  " $0}'
    echo ""
fi

echo "========================================"
SYSINFO

cat > /usr/local/bin/maxregner-utils/system-monitor << 'SYSMON'
# MaxRegner OS System Monitor Script

# Check if running as root
if [ "$(id -u)" -ne 0 ]; then
    echo "Please run as root for full system monitoring"
fi

echo "========================================"
echo "MaxRegner OS System Monitor"
echo "========================================"
echo ""

# Check CPU usage
CPU_USAGE=$(top -bn1 | grep "Cpu(s)" | sed "s/.*, *\([0-9.]*\)%* id.*/\1/" | awk '{print 100 - $1}')
echo "CPU Usage: ${CPU_USAGE}%"

# Check memory usage
MEM_USAGE=$(free | awk '/Mem:/ {printf "%.2f", $3/$2*100}')
echo "Memory Usage: ${MEM_USAGE}%"

# Check disk usage
DISK_USAGE=$(df / | awk 'NR==2 {printf "%.2f", $5*100}')
echo "Disk Usage: ${DISK_USAGE}%"

# Check temperature
if command -v sensors &>/dev/null; then
    CPU_TEMP=$(sensors | grep -E "Package id 0|temp1" | head -1 | awk '{print $4}' | tr -d '+°C')
    echo "CPU Temperature: ${CPU_TEMP}°C"
fi

# Check network
NET_RX=$(cat /proc/net/dev | grep eth0 | awk '{print $2}' | head -1)
NET_TX=$(cat /proc/net/dev | grep eth0 | awk '{print $10}' | head -1)
echo "Network: RX: ${NET_RX} bytes, TX: ${NET_TX} bytes"

# Check processes
PROC_COUNT=$(ps aux | wc -l)
echo "Running Processes: $PROC_COUNT"

# Check uptime
UPTIME=$(uptime -p | cut -d' ' -f2-)
echo "Uptime: $UPTIME"

echo ""
echo "========================================"
SYSMON

chmod +x /usr/local/bin/maxregner-utils/*

echo ""
echo "========================================"
echo "MaxRegner System Utilities Complete!"
echo "========================================"
