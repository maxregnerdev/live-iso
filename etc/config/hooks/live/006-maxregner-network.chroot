#!/bin/bash

set -e

# MaxRegner user configuration

# MaxRegner OS - Network Configuration Hook
# Configures all network settings for optimal performance
echo "========================================"
echo "MaxRegner OS - Network Configuration Hook"
echo "========================================"

# ============================================
# 1. NETWORK MANAGER CONFIGURATION
# ============================================

echo "[1/5] Configuring NetworkManager..."

# Main configuration
mkdir -p /etc/NetworkManager
cat > /etc/NetworkManager/NetworkManager.conf <<EOF
[main]
plugins=keyfile,ifupdown

[ifupdown]
managed=true

[keyfile]
unmanaged-devices=none

[device]
wifi.scan-rand-mac-address=no

[logging]
level=INFO
domains=ALL
EOF

# Create connection profiles
mkdir -p /etc/NetworkManager/system-connections

# Wired connection
cat > /etc/NetworkManager/system-connections/Wired.connection <<EOF
[connection]
id=Wired
uuid=$(uuidgen)
type=ethernet
interface-name=eth0
permissions=

[ethernet]

[ipv4]
method=auto

[ipv6]
method=auto
EOF

# Wireless connection
cat > /etc/NetworkManager/system-connections/MaxRegner-WiFi.connection <<EOF
[connection]
id=MaxRegner-WiFi
uuid=$(uuidgen)
type=wifi
permissions=

[wifi]
ssid=MaxRegner
mode=infrastructure
security=wpa-psk
psk=MaxRegner123

[wifi-security]
key-mgmt=wpa-psk
psk=MaxRegner123

[ipv4]
method=auto

[ipv6]
method=auto
EOF

# ============================================
# 2. HOSTNAME AND DNS CONFIGURATION
# ============================================

echo "[2/5] Configuring hostname and DNS..."

# Set hostname
cat > /etc/hostname <<EOF
maxregner
EOF

# Configure hosts
cat > /etc/hosts <<EOF
127.0.0.1	localhost
127.0.1.1	maxregner

# The following lines are desirable for IPv6 capable hosts
::1		localhost ip6-localhost ip6-loopback
ff02::1		ip6-allnodes
ff02::2		ip6-allrouters
EOF

# Configure resolv.conf
cat > /etc/resolv.conf <<EOF
# MaxRegner OS DNS Configuration
nameserver 1.1.1.1
nameserver 8.8.8.8
nameserver 9.9.9.9
options edns0 trust-ad
search localdomain
EOF

# Configure systemd-resolved
mkdir -p /etc/systemd/resolved.conf.d
cat > /etc/systemd/resolved.conf.d/maxregner.conf <<EOF
[Resolve]
DNS=1.1.1.1 8.8.8.8 9.9.9.9
FallbackDNS=1.0.0.1 8.8.4.4
Domains=~.
LLMNR=no
MulticastDNS=no
Cache=yes
DNSStubListener=yes
EOF

# ============================================
# 3. FIREWALL AND NETWORK SECURITY
# ============================================

echo "[3/5] Configuring network security..."

# Install firewall tools
apt-get install -y ufw iptables ip6tables arptables 2>/dev/null || true

# Configure UFW rules
ufw default deny incoming 2>/dev/null || true
ufw default allow outgoing 2>/dev/null || true
ufw allow ssh 2>/dev/null || true
ufw allow http 2>/dev/null || true
ufw allow https 2>/dev/null || true
ufw allow 53/tcp 2>/dev/null || true
ufw allow 53/udp 2>/dev/null || true
ufw --force enable 2>/dev/null || true

# Configure iptables rules
mkdir -p /etc/iptables
cat > /etc/iptables/rules.v4 <<EOF
*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]

# Allow loopback
-A INPUT -i lo -j ACCEPT
-A OUTPUT -o lo -j ACCEPT

# Allow established connections
-A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A OUTPUT -m conntrack --ctstate ESTABLISHED -j ACCEPT

# Allow SSH
-A INPUT -p tcp --dport 22 -j ACCEPT

# Allow HTTP/HTTPS
-A INPUT -p tcp --dport 80 -j ACCEPT
-A INPUT -p tcp --dport 443 -j ACCEPT

# Allow DNS
-A INPUT -p tcp --dport 53 -j ACCEPT
-A INPUT -p udp --dport 53 -j ACCEPT

# Allow ICMP
-A INPUT -p icmp --icmp-type echo-request -j ACCEPT

# Log dropped packets
-A INPUT -j LOG --log-prefix "[UFW-BLOCK] " --log-level 4
-A FORWARD -j LOG --log-prefix "[UFW-BLOCK] " --log-level 4

COMMIT
EOF

mkdir -p /etc/iptables
cat > /etc/iptables/rules.v6 <<EOF
*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]

# Allow loopback
-A INPUT -i lo -j ACCEPT
-A OUTPUT -o lo -j ACCEPT

# Allow established connections
-A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A OUTPUT -m conntrack --ctstate ESTABLISHED -j ACCEPT

# Allow SSH
-A INPUT -p tcp --dport 22 -j ACCEPT

# Allow HTTP/HTTPS
-A INPUT -p tcp --dport 80 -j ACCEPT
-A INPUT -p tcp --dport 443 -j ACCEPT

# Allow DNS
-A INPUT -p tcp --dport 53 -j ACCEPT
-A INPUT -p udp --dport 53 -j ACCEPT

# Allow ICMPv6
-A INPUT -p icmpv6 --icmpv6-type echo-request -j ACCEPT

# Log dropped packets
-A INPUT -j LOG --log-prefix "[UFW-BLOCK] " --log-level 4
-A FORWARD -j LOG --log-prefix "[UFW-BLOCK] " --log-level 4

COMMIT
EOF

# ============================================
# 4. NETWORK OPTIMIZATION
# ============================================

echo "[4/5] Optimizing network performance..."

# Configure sysctl for network
mkdir -p /etc/sysctl.d
cat > /etc/sysctl.d/99-maxregner-network.conf <<EOF
# MaxRegner OS Network Optimization

# TCP settings
net.core.netdev_max_backlog=5000
net.core.rmem_max=16777216
net.core.wmem_max=16777216
net.core.rmem_default=16777216
net.core.wmem_default=16777216
net.core.optmem_max=65536
net.core.somaxconn=4096

# TCP congestion control
net.ipv4.tcp_congestion_control=cubic
net.ipv4.tcp_no_metrics_save=1
net.ipv4.tcp_ecn=1
net.ipv4.tcp_syncookies=1
net.ipv4.tcp_max_syn_backlog=2048
net.ipv4.tcp_fin_timeout=15
net.ipv4.tcp_keepalive_time=300
net.ipv4.tcp_keepalive_probes=5
net.ipv4.tcp_keepalive_intvl=15

# TCP buffer sizes
net.ipv4.tcp_rmem=4096 87380 16777216
net.ipv4.tcp_wmem=4096 87380 16777216

# TCP retransmission
net.ipv4.tcp_retries1=3
net.ipv4.tcp_retries2=5

# IPv4 settings
net.ipv4.ip_local_port_range=1024 65535
net.ipv4.ip_no_pmtu_disc=0
net.ipv4.route.flush=1

# IPv6 settings
net.ipv6.conf.all.disable_ipv6=0
net.ipv6.conf.default.disable_ipv6=0
EOF

# Apply sysctl settings
sysctl -p /etc/sysctl.d/99-maxregner-network.conf 2>/dev/null || true

# ============================================
# 5. NETWORK SERVICES
# ============================================

echo "[5/5] Configuring network services..."

# Enable and start services
systemctl enable NetworkManager 2>/dev/null || true
systemctl enable systemd-resolved 2>/dev/null || true
systemctl enable systemd-networkd 2>/dev/null || true

# Configure avahi-daemon
mkdir -p /etc/avahi
cat > /etc/avahi/avahi-daemon.conf <<EOF
[server]
allow-interfaces=eth0,wlan0
use-ipv4=yes
use-ipv6=yes
enable-dbus=yes

[wide-area]
enable-wide-area=yes

[publish]
disable-user-service-publishing=no

[reflector]
enable-reflector=no
EOF

# Configure SSH for network
if [ -f /etc/ssh/sshd_config ]; then
    sed -i 's/^#ListenAddress 0.0.0.0/ListenAddress 0.0.0.0/' /etc/ssh/sshd_config
    sed -i 's/^#Port 22/Port 22/' /etc/ssh/sshd_config
fi

# ============================================
# FINAL CLEANUP
# ============================================

echo ""
echo "========================================"
echo "MaxRegner Network Configuration Complete!"
echo "========================================"
