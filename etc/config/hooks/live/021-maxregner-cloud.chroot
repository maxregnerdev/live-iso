
# MaxRegner user configuration
MAXREGNER_USER="${LIVE_USERNAME:-maxregner}"
MAXREGNER_HOME="/home/$MAXREGNER_USER"

#!/bin/bash
# MaxRegner OS - Cloud Integration Configuration Hook
# Configures cloud services and tools

set -e

echo "========================================"
echo "MaxRegner OS - Cloud Integration Hook"
echo "========================================"

# ============================================
# 1. INSTALL CLOUD TOOLS
# ============================================

echo "[1/5] Installing cloud tools..."

# Install AWS CLI
apt-get install -y awscli 2>/dev/null || true

# Install Azure CLI
apt-get install -y azure-cli 2>/dev/null || true

# Install Google Cloud SDK
apt-get install -y google-cloud-sdk google-cloud-sdk-app-engine-python \
    google-cloud-sdk-datastore-emulator google-cloud-sdk-pubsub-emulator \
    google-cloud-sdk-firestore-emulator 2>/dev/null || true

# Install OpenStack CLI
apt-get install -y python3-openstackclient python3-heatclient \
    python3-ironicclient python3-troveclient 2>/dev/null || true

# ============================================
# 2. CONFIGURE AWS CLI
# ============================================

echo "[2/5] Configuring AWS CLI..."

# Configure AWS CLI
mkdir -p /home/$MAXREGNER_USER/.aws
cat > /home/$MAXREGNER_USER/.aws/config << 'AWSEOF'
# MaxRegner OS AWS CLI Configuration

[default]
region = us-east-1
output = json

[profile maxregner]
region = eu-west-1
output = json

[profile development]
region = us-west-2
output = text
AWSEOF

cat > /home/$MAXREGNER_USER/.aws/credentials << 'CREDSEOF'
# MaxRegner OS AWS Credentials
# Placeholder - users should add their own credentials

[default]
aws_access_key_id = YOUR_ACCESS_KEY
aws_secret_access_key = YOUR_SECRET_KEY

[maxregner]
aws_access_key_id = YOUR_ACCESS_KEY
aws_secret_access_key = YOUR_SECRET_KEY
CREDSEOF

chown -R "$MAXREGNER_USER:$MAXREGNER_USER" /home/$MAXREGNER_USER/.aws
chmod 600 /home/$MAXREGNER_USER/.aws/credentials

# ============================================
# 3. CONFIGURE AZURE CLI
# ============================================

echo "[3/5] Configuring Azure CLI..."

# Configure Azure CLI
mkdir -p /home/$MAXREGNER_USER/.azure
cat > /home/$MAXREGNER_USER/.azure/config << 'AZUREEOF'
# MaxRegner OS Azure CLI Configuration

[cloud]
name = AzureCloud

[core]
collect_telemetry = no
output = json

[logging]
enable_logging = yes
log_level = info
log_file = /home/$MAXREGNER_USER/.azure/azure.log
AZUREEOF

chown -R "$MAXREGNER_USER:$MAXREGNER_USER" /home/$MAXREGNER_USER/.azure

# ============================================
# 4. CONFIGURE GOOGLE CLOUD SDK
# ============================================

echo "[4/5] Configuring Google Cloud SDK..."

# Configure Google Cloud SDK
mkdir -p /home/$MAXREGNER_USER/.config/gcloud
mkdir -p /home/$MAXREGNER_USER/.config/gcloud/configurations
cat > /home/$MAXREGNER_USER/.config/gcloud/configurations/config_default << 'GCLOUDEOF'
# MaxRegner OS Google Cloud SDK Configuration

[core]
account = maxregner@maxregneros.com
project = maxregner-os
region = us-central1
zone = us-central1-a

[compute]
region = us-central1
zone = us-central1-a

[container]
use_client_certificate = False

[logs]
counter = 2
GCLOUDEOF

cat > /home/$MAXREGNER_USER/.config/gcloud/credentials.db << 'CREDSEOF'
# MaxRegner OS Google Cloud Credentials
# Placeholder - users should authenticate with gcloud auth login

[Credentials]
maxregner@maxregneros.com = {"token": "", "refresh_token": "", "token_expiry": "", "id_token": "", "id_token_expiry": ""}
CREDSEOF

chown -R "$MAXREGNER_USER:$MAXREGNER_USER" /home/$MAXREGNER_USER/.config/gcloud

# ============================================
# 5. CONFIGURE CLOUD-INIT
# ============================================

echo "[5/5] Configuring cloud-init..."

# Install cloud-init
apt-get install -y cloud-init cloud-image-utils cloud-guest-utils 2>/dev/null || true

# Configure cloud-init
mkdir -p /etc/cloud/cloud.cfg.d
cat > /etc/cloud/cloud.cfg.d/99-maxregner.cfg << 'CLOUDEOF'
# MaxRegner OS cloud-init Configuration

# System settings
system_info:
  default_user:
    name: maxregner
    home: /home/$MAXREGNER_USER
    shell: /bin/bash
    lock_passwd: false
    sudo: ALL=(ALL) NOPASSWD:ALL

# Cloud settings
cloud_init_modules:
  - migrator
  - seed_random
  - bootcmd
  - write-files
  - growpart
  - resizefs
  - set_hostname
  - update_hostname
  - update_etc_hosts
  - ca-certs
  - rsyslog
  - users-groups
  - ssh

cloud_config_modules:
  - mounts
  - locale
  - set-passwords
  - yum-add-repo
  - package-update-upgrade-install
  - timezone
  - puppet
  - chef
  - salt-minion
  - mcollective
  - disable-ec2-metadata
  - runcmd

cloud_final_modules:
  - rightscale_userdata
  - scripts-per-once
  - scripts-per-boot
  - scripts-per-instance
  - scripts-user
  - ssh-authkey-fingerprints
  - keys-to-console
  - phone-home
  - final-message
  - power-state-change

# Datasource settings
datasource:
  Ec2:
    timeout: 5
    max_wait: 120
  Azure:
    timeout: 5
    max_wait: 120
  GCE:
    timeout: 5
    max_wait: 120
  OpenStack:
    timeout: 5
    max_wait: 120

# Network settings
network:
  config: disabled
CLOUDEOF

# Configure cloud-init userdata
mkdir -p /etc/cloud
cat > /etc/cloud/userdata.yml << 'USERDATAEOF'
#cloud-config

# MaxRegner OS cloud-init User Data

# User settings
users:
  - name: maxregner
    gecos: MaxRegner OS User
    primary_group: maxregner
    groups: users, admin, sudo, docker
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: false
    passwd: $6$rounds=4096$salt$hashed_password
    shell: /bin/bash
    home: /home/$MAXREGNER_USER

# SSH settings
ssh_pwauth: true
ssh_authorized_keys:
  - ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABAQ... user@host

# Package settings
packages:
  - qemu-guest-agent
  - cloud-init
  - cloud-utils
  - open-vm-tools

# Run commands
runcmd:
  - [ systemctl, enable, qemu-guest-agent ]
  - [ systemctl, start, qemu-guest-agent ]
  - [ systemctl, enable, cloud-init ]
  - [ systemctl, start, cloud-init ]

# Final message
final_message: "MaxRegner OS cloud-init configuration complete!"
USERDATAEOF

# Enable and start cloud-init
systemctl enable cloud-init 2>/dev/null || true
systemctl start cloud-init 2>/dev/null || true

echo ""
echo "========================================"
echo "MaxRegner Cloud Integration Complete!"
echo "========================================"
