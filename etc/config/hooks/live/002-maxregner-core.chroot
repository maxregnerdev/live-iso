#!/bin/bash

set -e

# MaxRegner user configuration
MAXREGNER_USER="${LIVE_USERNAME:-maxregner}"

MAXREGNER_HOME="/home/$MAXREGNER_USER"

# MaxRegner OS - Core Packages Installation Hook
# This hook installs all MaxRegner-specific core packages
echo "========================================"
echo "MaxRegner OS - Core Packages Hook"
echo "========================================"

# Source configuration
if [ -f /working_dir/maxregner-os/config/terraform-maxregner.conf ]; then
    source /working_dir/maxregner-os/config/terraform-maxregner.conf
elif [ -f /etc/terraform.conf ]; then
    source /etc/terraform.conf
fi

# ============================================
# 1. INSTALL MAXREGNER THEME
# ============================================

echo "[1/10] Installing MaxRegner theme..."

# Create theme directory
mkdir -p /usr/share/themes/MaxRegner-Ultimate/gtk-3.0

# Create GTK 3.0 theme
cat > /usr/share/themes/MaxRegner-Ultimate/gtk-3.0/gtk.css <<'THEMEEOF'
/* MaxRegner OS Ultimate - GTK 3.0 Theme */
@import url("gtk-dark.css");

@define-color bg_color #1a1a2e;
@define-color fg_color #eaeaea;
@define-color primary_color #16213e;
@define-color secondary_color #0f3460;
@define-color accent_color #e94560;
@define-color success_color #4caf50;
@define-color warning_color #ff9800;
@define-color error_color #f44336;

window.frame { background-color: @bg_color; }
headerbar { background-color: @primary_color; color: @fg_color; border-radius: 0; }
button { background-color: @secondary_color; color: @fg_color; border-radius: 4px; }
entry { background-color: @primary_color; color: @fg_color; border-radius: 4px; }
THEMEEOF

# Create GTK 4.0 theme
mkdir -p /usr/share/themes/MaxRegner-Ultimate/gtk-4.0
cat > /usr/share/themes/MaxRegner-Ultimate/gtk-4.0/gtk.css <<'THEMEEOF'
/* MaxRegner OS Ultimate - GTK 4.0 Theme */
@import url("gtk-dark.css");

button { background-color: #0f3460; color: #eaeaea; border-radius: 4px; }
entry { background-color: #16213e; color: #eaeaea; border-radius: 4px; }
window { background-color: #1a1a2e; }
THEMEEOF

# Create GNOME Shell theme
mkdir -p /usr/share/themes/MaxRegner-Ultimate/gnome-shell
cat > /usr/share/themes/MaxRegner-Ultimate/gnome-shell/gnome-shell.css <<'THEMEEOF'
/* MaxRegner OS Ultimate - GNOME Shell Theme */
#panel { background-color: rgba(22, 33, 62, 0.9); border-bottom: 1px solid #0f3460; }
.panel-button { background-color: transparent; color: #eaeaea; }
.panel-button:hover { background-color: rgba(15, 52, 96, 0.5); }
THEMEEOF

# Create theme index
cat > /usr/share/themes/MaxRegner-Ultimate/index.theme <<'THEMEEOF'
[Desktop Entry]
Type=X-GNOME-Metatheme
Name=MaxRegner-Ultimate
Comment=MaxRegner OS Ultimate Theme
Encoding=UTF-8

[X-GNOME-Metatheme]
GtkTheme=MaxRegner-Ultimate
IconTheme=MaxRegner-Icons
CursorTheme=MaxRegner-Cursor
MetacityTheme=MaxRegner-Ultimate

[X-GNOME-Metacity]
Name=MaxRegner-Ultimate
THEMEEOF

# Set default theme
gsettings set org.gnome.desktop.interface gtk-theme "MaxRegner-Ultimate" 2>/dev/null || true
gsettings set org.gnome.desktop.interface icon-theme "MaxRegner-Icons" 2>/dev/null || true
gsettings set org.gnome.desktop.interface cursor-theme "MaxRegner-Cursor" 2>/dev/null || true

# ============================================
# 2. INSTALL MAXREGNER ICONS
# ============================================

echo "[2/10] Installing MaxRegner icons..."

mkdir -p /usr/share/icons/MaxRegner-Icons/16x16/apps
mkdir -p /usr/share/icons/MaxRegner-Icons/scalable/apps

# Create a sample icon
cat > /usr/share/icons/MaxRegner-Icons/scalable/apps/terminal.svg <<'ICONEOF'
<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 48 48">
  <rect x="4" y="4" width="40" height="40" rx="4" fill="#16213e"/>
  <rect x="6" y="6" width="36" height="36" rx="2" fill="none" stroke="#e94560" stroke-width="2"/>
  <line x1="12" y1="12" x2="36" y2="12" stroke="#eaeaea" stroke-width="2"/>
  <line x1="12" y1="16" x2="32" y2="16" stroke="#eaeaea" stroke-width="2"/>
  <line x1="12" y1="20" x2="28" y2="20" stroke="#eaeaea" stroke-width="2"/>
</svg>
ICONEOF

# Create icon theme index
cat > /usr/share/icons/MaxRegner-Icons/index.theme <<'ICONEOF'
[Icon Theme]
Name=MaxRegner-Icons
Comment=MaxRegner OS Icon Theme
Inherits=Adwaita,hicolor
Directories=16x16/apps,24x24/apps,32x32/apps,48x48/apps,64x64/apps,scalable/apps
Size=16,24,32,48,64
Type=Fixed,Scalable

[16x16/apps]
Size=16
Context=Applications
Path=16x16/apps

[24x24/apps]
Size=24
Context=Applications
Path=24x24/apps

[32x32/apps]
Size=32
Context=Applications
Path=32x32/apps

[48x48/apps]
Size=48
Context=Applications
Path=48x48/apps

[64x64/apps]
Size=64
Context=Applications
Path=64x64/apps

[scalable/apps]
Size=Scalable
Context=Applications
Path=scalable/apps
ICONEOF

# ============================================
# 3. INSTALL MAXREGNER WALLPAPERS
# ============================================

echo "[3/10] Installing MaxRegner wallpapers..."

mkdir -p /usr/share/backgrounds/maxregner

# Create a gradient wallpaper using ImageMagick if available
if command -v convert >/dev/null 2>&1; then
    convert -size 1920x1080 \
        -fill "#1a1a2e" -draw "rectangle 0,0 1920,1080" \
        -fill "#16213e" -draw "rectangle 0,0 1920,540" \
        -fill "#0f3460" -draw "rectangle 0,0 1920,270" \
        /usr/share/backgrounds/maxregner/default.jpg 2>/dev/null || true
else
    # Create a simple placeholder
    cat > /usr/share/backgrounds/maxregner/default.jpg <<'WPEOF'
PNG


WPEOF
fi

# Set default wallpaper
gsettings set org.gnome.desktop.background picture-uri "file:///usr/share/backgrounds/maxregner/default.jpg" 2>/dev/null || true
gsettings set org.gnome.desktop.background picture-uri-dark "file:///usr/share/backgrounds/maxregner/default.jpg" 2>/dev/null || true

# ============================================
# 4. INSTALL MAXREGNER CURSORS
# ============================================

echo "[4/10] Installing MaxRegner cursors..."

mkdir -p /usr/share/icons/MaxRegner-Cursor/cursors

# Create a simple cursor (placeholder)
cat > /usr/share/icons/MaxRegner-Cursor/cursor.theme <<'CURSOREOF'
[Icon Theme]
Name=MaxRegner-Cursor
Comment=MaxRegner OS Cursor Theme
Inherits=DMZ-White
CURSOREOF

# ============================================
# 5. INSTALL MAXREGNER PLYMOUTH THEME
# ============================================

echo "[5/10] Installing MaxRegner Plymouth theme..."

mkdir -p /usr/share/plymouth/themes/maxregner-ultimate

# Create Plymouth theme configuration
cat > /usr/share/plymouth/themes/maxregner-ultimate/maxregner-ultimate.plymouth <<'PLYMOUTHEOF'
[Plymouth Theme]
Name=MaxRegner Ultimate
Description=MaxRegner OS Ultimate Plymouth Theme
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/maxregner-ultimate
ScriptFile=/usr/share/plymouth/themes/maxregner-ultimate/maxregner-ultimate-script
PLYMOUTHEOF

# Create Plymouth script
cat > /usr/share/plymouth/themes/maxregner-ultimate/maxregner-ultimate-script <<'PLYMOUTHEOF'
plymouth set-refresh-rate 60
plymouth image --file=/usr/share/plymouth/themes/maxregner-ultimate/background.png --section=0,0,1920,1080
PLYMOUTHEOF

chmod +x /usr/share/plymouth/themes/maxregner-ultimate/maxregner-ultimate-script

# Set default Plymouth theme
plymouth-set-default-theme maxregner-ultimate 2>/dev/null || true

# ============================================
# 6. INSTALL MAXREGNER SOUNDS
# ============================================

echo "[6/10] Installing MaxRegner sounds..."

mkdir -p /usr/share/sounds/maxregner
mkdir -p /usr/share/sounds/maxregner/stereo

# Create sound theme index
cat > /usr/share/sounds/maxregner/index.theme <<'SOUNDEOF'
[Sound Theme]
Name=MaxRegner
Comment=MaxRegner OS Sound Theme
Directories=stereo

[stereo]
Path=stereo
SOUNDEOF

# ============================================
# 7. INSTALL MAXREGNER FONTS
# ============================================

echo "[7/10] Installing MaxRegner fonts..."

mkdir -p /usr/share/fonts/truetype/maxregner

# Create a simple font (placeholder)
# In a real system, we would install actual font files here

# ============================================
# 8. CONFIGURE GNOME SHELL
# ============================================

echo "[8/10] Configuring GNOME Shell..."

# Enable user-theme extension
gsettings set org.gnome.shell.extensions.user-theme name "MaxRegner-Ultimate" 2>/dev/null || true

# Configure shell settings
gsettings set org.gnome.desktop.interface gtk-theme "MaxRegner-Ultimate" 2>/dev/null || true
gsettings set org.gnome.desktop.interface icon-theme "MaxRegner-Icons" 2>/dev/null || true
gsettings set org.gnome.desktop.interface cursor-theme "MaxRegner-Cursor" 2>/dev/null || true
gsettings set org.gnome.desktop.interface font-name "Cantarell 11" 2>/dev/null || true

# Configure shell extensions
gsettings set org.gnome.shell enabled-extensions "['user-theme@gnome-shell-extensions.gcampax.github.com', 'dash-to-dock@micxgx.gmail.com']" 2>/dev/null || true

# ============================================
# 9. INSTALL MAXREGNER UTILITIES
# ============================================

echo "[9/10] Installing MaxRegner utilities..."

# Create MaxRegner utilities directory
mkdir -p /usr/share/maxregner/utils

# Create system info script
mkdir -p /usr/bin
cat > /usr/bin/maxregner-info <<'UTILEOF'
echo "MaxRegner OS Information"
echo "======================="
echo "Version: $(cat /etc/os-release | grep VERSION= | cut -d'"' -f2)"
echo "Codename: $(cat /etc/os-release | grep CODENAME= | cut -d'"' -f2)"
echo "User: $(whoami)"
echo "Hostname: $(hostname)"
echo "Kernel: $(uname -r)"
echo "Uptime: $(uptime -p)"
echo "CPU: $(lscpu | grep "Model name" | cut -d':' -f2 | xargs)"
echo "Memory: $(free -h | awk '/Mem/{print $3 "/" $2}')"
UTILEOF

chmod +x /usr/bin/maxregner-info

# ============================================
# 10. FINAL TOUCHES
# ============================================

echo "[10/10] Final touches..."

# Create MaxRegner menu
mkdir -p /usr/share/applications/maxregner

# Create welcome application
cat > /usr/share/applications/maxregner-welcome.desktop <<'APPEOF'
[Desktop Entry]
Type=Application
Name=MaxRegner OS Welcome
Comment=Welcome to MaxRegner OS
Exec=yelp help:user-guide
Icon=system-help
Terminal=false
Categories=Help;System;
StartupNotify=false
APPEOF

# Update GNOME favorite apps
gsettings set org.gnome.shell favorite-apps "['maxregner-welcome.desktop', 'firefox-esr.desktop', 'nautilus.desktop', 'gnome-terminal.desktop']" 2>/dev/null || true

# Clean up
rm -rf /tmp/maxregner-core-setup 2>/dev/null || true

echo ""
echo "========================================"
echo "MaxRegner OS Core Setup Complete!"
echo "========================================"
