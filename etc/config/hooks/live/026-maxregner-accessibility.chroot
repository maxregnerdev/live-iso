
# MaxRegner user configuration
MAXREGNER_USER="${LIVE_USERNAME:-maxregner}"
MAXREGNER_HOME="/home/$MAXREGNER_USER"

#!/bin/bash
# MaxRegner OS - Accessibility Features Configuration Hook
# Configures comprehensive accessibility support

set -e

echo "========================================"
echo "MaxRegner OS - Accessibility Hook"
echo "========================================"

# ============================================
# 1. INSTALL ACCESSIBILITY TOOLS
# ============================================

echo "[1/5] Installing accessibility tools..."

# Install accessibility packages
apt-get install -y orca gnome-orca brltty brltty-espeak \
    espeak espeak-ng festival festvox-kallpc16k flite \
    speech-dispatcher speech-dispatcher-espeak-ng speech-dispatcher-festival \
    at-spi2-core at-spi2-atk at-spi2-atk-adaptor at-spi2-core \
    libatspi2.0-0 libatk-adaptor libatk-bridge2.0-0 \
    caribou florence onboard mousetweaks stickykeys \
    compiz-plugins-accessibility eog-plugins 2>/dev/null || true

# ============================================
# 2. CONFIGURE ORCA SCREEN READER
# ============================================

echo "[2/5] Configuring Orca screen reader..."

# Configure Orca
mkdir -p /etc/orca
cat > /etc/orca/orca-customizations.py << 'ORCACONF'
# MaxRegner OS Orca Configuration

import orca.orca as orca
import orca.orca_state as orca_state

# General settings
orca_state.speechRate = 450
orca_state.voice = "en_US"

# Braille settings
orca_state.brailleDriver = "brltty"
orca_state.brailleTable = "en-ueb-g2.ctb"

# Speech settings
orca_state.speechVoice = "en_US"
orca_state.speechRate = 450
orca_state.speechPitch = 50
orca_state.speechVolume = 100

# Verbosity settings
orca_state.verbosityLevel = orca.VERBOSITY_LEVEL_MEDIUM
orca_state.echoByWord = False
orca_state.echoByCharacter = False

# Cursor tracking
orca_state.caretTrackingMode = orca.CARET_TRACKING_MODE_TEXT
orca_state.mouseReviewTrackingMode = orca.MOUSE_REVIEW_TRACKING_MODE_OFF

# Braille settings
orca_state.brailleEnabled = True
orca_state.brailleDriver = "brltty"
orca_state.brailleTable = "en-ueb-g2.ctb"

# Focus tracking
orca_state.focusTrackingMode = orca.FOCUS_TRACKING_MODE_ALL

# Key bindings
orca_state.keyBindings = {
    "sayAll": "<Control><Alt>a",
    "stopSpeaking": "<Control>c",
    "readCurrentLine": "<Control>l",
    "readCurrentWord": "<Control>w",
    "readCurrentCharacter": "<Control>c",
    "nextItem": "Tab",
    "previousItem": "<Shift>Tab",
    "nextLine": "Down",
    "previousLine": "Up",
    "nextWord": "<Control>Right",
    "previousWord": "<Control>Left",
}
ORCACONF

# Orca user preferences
mkdir -p /home/$MAXREGNER_USER/.config/orca
cat > /home/$MAXREGNER_USER/.config/orca/user-settings.conf << 'ORCAUSERCONF'
# MaxRegner OS Orca User Settings

[general]
start-automatically=true
enable-in=all

[speech]
rate=450
pitch=50
volume=100
voice=en_US

[braille]
enabled=true
driver=brltty
table=en-ueb-g2.ctb

[verbosity]
level=medium
echo-by-word=false
echo-by-character=false

[cursor]
tracking-mode=text
mouse-review-tracking-mode=off

[focus]
tracking-mode=all
ORCAUSERCONF

chown -R "$MAXREGNER_USER:$MAXREGNER_USER" /home/$MAXREGNER_USER/.config/orca

# ============================================
# 3. CONFIGURE SPEECH DISPATCHER
# ============================================

echo "[3/5] Configuring Speech Dispatcher..."

# Configure Speech Dispatcher
mkdir -p /etc/speech-dispatcher
cat > /etc/speech-dispatcher/speechd.conf << 'SPEECHDCONF'
# MaxRegner OS Speech Dispatcher Configuration

# Main settings
SpeechDispatchModule  "espeak-ng"
AudioOutputMethod     "pulse"

# Log settings
LogLevel              "3"
LogFile               "/var/log/speech-dispatcher.log"

# Audio settings
AudioCommand          "paplay %f"
AudioMethod           "file"

# Language settings
DefaultLanguage       "en_US"

# Module settings
ModulePath            "/usr/lib/speech-dispatcher-modules"

# ESpeak NG settings
AddModule "espeak-ng"   "sd_espeak-ng"  "espeak-ng"

# Festival settings
AddModule "festival"    "sd_festival"   "festival"

# Voice settings
Voice "en_US"         "default"
Voice "en_GB"         "english"
SPEECHDCONF

# Configure Speech Dispatcher client
mkdir -p /etc/speech-dispatcher/clients
cat > /etc/speech-dispatcher/clients/orca.conf << 'ORCASPEECHCONF'
# MaxRegner OS Orca Speech Dispatcher Client

# Client settings
ClientName "Orca"

# Priority
Priority 100

# Audio
AudioOutputMethod "pulse"
AudioCommand "paplay %f"

# Voice
Voice "en_US"
Rate 450
Pitch 50
Volume 100
ORCASPEECHCONF

# ============================================
# 4. CONFIGURE KEYBOARD ACCESSIBILITY
# ============================================

echo "[4/5] Configuring keyboard accessibility..."

# Configure Sticky Keys
mkdir -p /etc/default
cat > /etc/default/stickykeys << 'STICKYCONF'
# MaxRegner OS Sticky Keys Configuration

# Enable Sticky Keys
XKB_DEFAULT_OPTIONS="stickykeys:two_key"

# Sticky Keys settings
STICKYKEYS_ENABLED=1
STICKYKEYS_TIMEOUT=0
STICKYKEYS_LATCH=0
STICKYKEYS_LOCK=0
STICKYKEYS_BEEP=0
STICKYCONF

# Configure Slow Keys
mkdir -p /etc/default
cat > /etc/default/slowkeys << 'SLOWCONF'
# MaxRegner OS Slow Keys Configuration

# Enable Slow Keys
SLOWKEYS_ENABLED=0
SLOWKEYS_DELAY=1000
SLOWKEYS_REPEAT=1
SLOWCONF

# Configure Bounce Keys
mkdir -p /etc/default
cat > /etc/default/bouncekeys << 'BOUNCECONF'
# MaxRegner OS Bounce Keys Configuration

# Enable Bounce Keys
BOUNCEKEYS_ENABLED=0
BOUNCEKEYS_DELAY=500
BOUNCECONF

# Configure Mouse Tweaks
mkdir -p /etc/xdg/autostart
cat > /etc/xdg/autostart/mousetweaks.desktop << 'MOUSEDESKTOP'
[Desktop Entry]
Type=Application
Name=Mouse Tweaks
Exec=mousetweaks
OnlyShowIn=GNOME;
NoDisplay=true
X-GNOME-Autostart-enabled=true
MOUSEDESKTOP

# ============================================
# 5. ENABLE AND START SERVICES
# ============================================

echo "[5/5] Enabling accessibility services..."

# Enable and start services
systemctl enable speech-dispatcher 2>/dev/null || true
systemctl enable brltty 2>/dev/null || true

# Start services
systemctl start speech-dispatcher 2>/dev/null || true
systemctl start brltty 2>/dev/null || true

# Enable accessibility in GNOME
gsettings set org.gnome.desktop.a11y applications screen-reader-enabled true 2>/dev/null || true
gsettings set org.gnome.desktop.a11y interface toolkit-accessibility true 2>/dev/null || true
gsettings set org.gnome.desktop.a11y.keyboard stickykeys-enable true 2>/dev/null || true
gsettings set org.gnome.desktop.a11y.keyboard slowkeys-enable false 2>/dev/null || true
gsettings set org.gnome.desktop.a11y.keyboard bouncekeys-enable false 2>/dev/null || true

echo ""
echo "========================================"
echo "MaxRegner Accessibility Complete!"
echo "========================================"
