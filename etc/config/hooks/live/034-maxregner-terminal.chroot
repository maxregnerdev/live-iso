
# MaxRegner user configuration
MAXREGNER_USER="${LIVE_USERNAME:-maxregner}"
MAXREGNER_HOME="/home/$MAXREGNER_USER"

#!/bin/bash
# MaxRegner OS - Terminal Emulator Configuration Hook
# Configures comprehensive terminal support

set -e

echo "========================================"
echo "MaxRegner OS - Terminal Hook"
echo "========================================"

# ============================================
# 1. INSTALL TERMINAL EMULATORS
# ============================================

echo "[1/5] Installing terminal emulators..."

# Install GNOME Terminal
apt-get install -y gnome-terminal gnome-terminal-data gnome-terminal-server \
    gnome-terminal-nautilus 2>/dev/null || true

# Install Konsole (KDE)
apt-get install -y konsole konsole-kpart 2>/dev/null || true

# Install XFCE Terminal
apt-get install -y xfce4-terminal xfce4-terminal-plugin 2>/dev/null || true

# Install LXTerminal
apt-get install -y lxterminal 2>/dev/null || true

# Install Terminator
apt-get install -y terminator terminator-common 2>/dev/null || true

# Install Tilix
apt-get install -y tilix tilix-nautilus 2>/dev/null || true

# Install Alacritty
apt-get install -y alacritty 2>/dev/null || true

# Install Kitty
apt-get install -y kitty 2>/dev/null || true

# ============================================
# 2. CONFIGURE GNOME TERMINAL
# ============================================

echo "[2/5] Configuring GNOME Terminal..."

# Create GNOME Terminal configuration
mkdir -p /home/$MAXREGNER_USER/.config/dconf
cat > /home/$MAXREGNER_USER/.config/dconf/user << 'GNOMETERMCONF'
[org/gnome/Terminal]
legacy-profiles=/org/gnome/terminal/legacy/profiles:/:b1dcc9dd-5262-4d8d-a863-c897e6d979b9/

[org/gnome/Terminal/Legacy]
ProfilesList=/org/gnome/terminal/legacy/profiles:/:b1dcc9dd-5262-4d8d-a863-c897e6d979b9/

[org/gnome/Terminal/Legacy/Profile:/org/gnome/terminal/legacy/profiles:/:b1dcc9dd-5262-4d8d-a863-c897e6d979b9/]
visible-name=MaxRegner Terminal
login-shell=false
use-system-font=true
font=Cantarell 11
cursor-blink-mode=on
cursor-shape=block
foreground-color=#eaeaea
background-color=#1a1a2e
bold-color=#ffffff
bold-color-same-as-fg=false
palette=#2d2d2d:#f81ce5:#00ff00:#ffff00:#0000ff:#ff00ff:#00ffff:#ffffff:#2d2d2d:#f81ce5:#00ff00:#ffff00:#0000ff:#ff00ff:#00ffff:#ffffff
use-theme-colors=false
use-theme-background=false
use-transparent-background=false
background-transparency-percent=0
scrollbar-position=right
default-size-rows=25
default-size-columns=80
exit-action=close
text-blink-mode=system
backspace-binding=ascii-del
delete-binding=ascii-127
scroll-on-output=true
scroll-on-keystroke=true
scrollback-lines=10000
allow-bold=true
allow-underline=true
allow-strikethrough=true
allow-colors=true
encoding=UTF-8
use-custom-default-terminal-size=false
custom-terminal-size-rows=0
custom-terminal-size-columns=0

[org/gnome/Terminal/ProfilesList]
default=/org/gnome/terminal/legacy/profiles:/:b1dcc9dd-5262-4d8d-a863-c897e6d979b9/

[org/gnome/desktop/background]
primary-color=#1a1a2e
secondary-color=#16213e
color-shading-type=vertical
picture-options=zoom
picture-opacity=100
GNOMETERMCONF

chown "$MAXREGNER_USER:$MAXREGNER_USER" /home/$MAXREGNER_USER/.config/dconf/user

# Create GNOME Terminal profile
mkdir -p /home/$MAXREGNER_USER/.bash_profile.d
cat > /home/$MAXREGNER_USER/.bash_profile.d/terminal.sh << 'TERMPROFILE'
# MaxRegner OS Terminal Profile

# Terminal settings
export PS1='\u@\h:\w\$ '
export PROMPT_COMMAND='history -a; history -n; echo -ne "\e[0m"'

# Aliases
alias ll='ls -la'
alias la='ls -A'
alias l='ls -CF'
alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias egrep='egrep --color=auto'
alias fgrep='fgrep --color=auto'

# MaxRegner specific
alias update='sudo apt update && sudo apt upgrade -y && sudo apt autoremove -y'
alias clean='sudo apt clean && sudo apt autoclean'
alias rebuild='sudo dpkg-reconfigure -a'
alias restart='sudo systemctl restart'
alias stop='sudo systemctl stop'
alias start='sudo systemctl start'

# Color settings
export LS_COLORS='di=01;34:ln=00;36:so=01;35:pi=40;33:ex=01;32:bd=40;33;01:cd=40;33;01:su=01;34:sg=01;36:tw=01;32:ow=01;33;01'

# History settings
export HISTCONTROL=ignoreboth
export HISTSIZE=10000
export HISTFILESIZE=20000
export HISTIGNORE='ls:ll:la:cd:pwd:exit:history'

# Editor
export EDITOR=nano
export VISUAL=nano

# Pager
export PAGER=less
export LESS='-R --shift 5'
TERMPROFILE

chown "$MAXREGNER_USER:$MAXREGNER_USER" /home/$MAXREGNER_USER/.bash_profile.d/terminal.sh

# ============================================
# 3. CONFIGURE TERMINATOR
# ============================================

echo "[3/5] Configuring Terminator..."

# Create Terminator configuration
mkdir -p /home/$MAXREGNER_USER/.config/terminator
cat > /home/$MAXREGNER_USER/.config/terminator/config << 'TERMINATORCONF'
# MaxRegner OS Terminator Configuration

[global_config]
  title_transmit_bg_color = "#1a1a2e"
  title_inactive_bg_color = "#16213e"
  title_transmit_fg_color = "#eaeaea"
  title_inactive_fg_color = "#8892b0"
  focus = system
  always_on_top = False
  fullscreen = False
  borderless = False
  maximised = False
  tab_position = top
  tab_layout = horizontal
  scrollbar_position = right
  side_scrollbar_visible = True
  background_type = transparent
  background_darkness = 0.0
  use_system_font = True
  font = Cantarell 11
  cursor_blink = True
  cursor_shape = block
  scroll_on_output = True
  scroll_on_keystroke = True
  scrollback_lines = 10000
  scrollback_infinite = False
  scrollback_forever = False
  exit_on_child_exit = False
  close_button_on_tab = True
  hide_from_taskbar = False
  always_show_tabs = False
  tab_close_buttons = gnome
  inactivity_timeout = 5
  urgent_bell = True
  visual_bell = True
  audible_bell = False
  bell_duration = 100
  word_chars = "-A-Za-z0-9,./=?%&#_~:;"

[keybindings]
  copy = <Primary>c
  paste = <Primary>v
  new_tab = <Primary>t
  new_window = <Primary>n
  close_tab = <Primary>w
  close_window = <Primary>q
  split_horiz = <Primary><Shift>o
  split_vert = <Primary><Shift>e
  next_tab = <Primary>Page_Down
  prev_tab = <Primary>Page_Up
  switch_to_tab_1 = <Alt>1
  switch_to_tab_2 = <Alt>2
  switch_to_tab_3 = <Alt>3
  switch_to_tab_4 = <Alt>4
  switch_to_tab_5 = <Alt>5
  switch_to_tab_6 = <Alt>6
  switch_to_tab_7 = <Alt>7
  switch_to_tab_8 = <Alt>8
  switch_to_tab_9 = <Alt>9
  switch_to_tab_10 = <Alt>0

[profiles]
  [[default]]
    visible_name = MaxRegner Terminal
    use_custom_command = False
    custom_command = /bin/bash
    use_custom_directory = False
    custom_directory = 
    login_shell = True
    scroll_on_output = True
    scroll_on_keystroke = True
    scrollback_lines = 10000
    scrollback_infinite = False
    scrollback_forever = False
    scrollbar_position = right
    side_scrollbar_visible = True
    background_type = transparent
    background_darkness = 0.0
    use_system_font = True
    font = Cantarell 11
    cursor_blink = True
    cursor_shape = block
    palette = "#2d2d2d:#f81ce5:#00ff00:#ffff00:#0000ff:#ff00ff:#00ffff:#ffffff:#2d2d2d:#f81ce5:#00ff00:#ffff00:#0000ff:#ff00ff:#00ffff:#ffffff"
    foreground_color = #eaeaea
    background_color = #1a1a2e
    bold_color = #ffffff
    bold_color_same_as_fg = False
    cursor_fg_color = #eaeaea
    cursor_bg_color = #1a1a2e
    highlight_color = #00ff00
    highlight_bg_color = #1a1a2e

[layouts]
  [[default]]
    [[[child0]]]
      type = Terminal
      parent = window0
      profile = default
      ratio = 0.5
      position = 0
    [[[child1]]]
      type = Terminal
      parent = window0
      profile = default
      ratio = 0.5
      position = 1
    [[[window0]]]
      type = Window
      parent = ""
      size = 1200, 800
      position = 0, 0

[window_state]
  [[default]]
    last_active_term = child0
    last_active_window = window0
    maximised = False
    fullscreen = False
TERMINATORCONF

chown -R "$MAXREGNER_USER:$MAXREGNER_USER" /home/$MAXREGNER_USER/.config/terminator

# ============================================
# 4. CONFIGURE ALACRITTY
# ============================================

echo "[4/5] Configuring Alacritty..."

# Create Alacritty configuration
mkdir -p /home/$MAXREGNER_USER/.config/alacritty
cat > /home/$MAXREGNER_USER/.config/alacritty/alacritty.yml << 'ALACRITTYCONF'
# MaxRegner OS Alacritty Configuration

# Window settings
window:
  dimensions:
    columns: 80
    lines: 25
  padding:
    x: 10
    y: 10
  decorations: full
  opacity: 1.0
  startup_mode: Windowed
  title: MaxRegner Terminal
  dynamic_title: true

# Scrolling
scrolling:
  history: 10000
  multiplier: 3

# Font
font:
  normal:
    family: Cantarell
    style: Regular
  bold:
    family: Cantarell
    style: Bold
  italic:
    family: Cantarell
    style: Italic
  size: 11.0

# Cursor
cursor:
  style: Block
  blinking: On

# Colors
colors:
  primary:
    background: '#1a1a2e'
    foreground: '#eaeaea'
  cursor:
    text: '#1a1a2e'
    cursor: '#eaeaea'
  normal:
    black: '#2d2d2d'
    red: '#f81ce5'
    green: '#00ff00'
    yellow: '#ffff00'
    blue: '#0000ff'
    magenta: '#ff00ff'
    cyan: '#00ffff'
    white: '#ffffff'
  bright:
    black: '#2d2d2d'
    red: '#f81ce5'
    green: '#00ff00'
    yellow: '#ffff00'
    blue: '#0000ff'
    magenta: '#ff00ff'
    cyan: '#00ffff'
    white: '#ffffff'

# Selection
selection:
  semantic_escape: "\x1b[1;32m"
  save_to_clipboard: true

# Live config reload
live_config_reload: true

# MaxRegner specific
maxregner:
  enabled: true
  branding: "MaxRegner OS"
ALACRITTYCONF

chown -R "$MAXREGNER_USER:$MAXREGNER_USER" /home/$MAXREGNER_USER/.config/alacritty

# ============================================
# 5. CONFIGURE SHELL PROFILES
# ============================================

echo "[5/5] Configuring shell profiles..."

# Configure bashrc
cat > /home/$MAXREGNER_USER/.bashrc << 'BASHRC'
# MaxRegner OS Bash Configuration

# If not running interactively, don't do anything
case $- in
    *i*) ;;
      *) return;;
esac

# Source global settings
if [ -f /etc/bashrc ]; then
    . /etc/bashrc
fi

# Source terminal settings
if [ -f ~/.bash_profile.d/terminal.sh ]; then
    . ~/.bash_profile.d/terminal.sh
fi

# Source MaxRegner settings
if [ -f /etc/maxregner/bashrc ]; then
    . /etc/maxregner/bashrc
fi

# MaxRegner specific
PS1='\[\e[32m\]\u@\h\[\e[0m\]:\[\e[34m\]\w\[\e[0m\]\$ '
PROMPT_COMMAND='history -a; history -n; echo -ne "\e[0m"'

# Load bash completion
if ! shopt -oq posix; then
    if [ -f /usr/share/bash-completion/bash_completion ]; then
        . /usr/share/bash-completion/bash_completion
    elif [ -f /etc/bash_completion ]; then
        . /etc/bash_completion
    fi
fi

# Enable completion
if [ -f /usr/share/bash-completion/completions/git ]; then
    source /usr/share/bash-completion/completions/git
fi

# History settings
export HISTCONTROL=ignoreboth
export HISTSIZE=10000
export HISTFILESIZE=20000
export HISTIGNORE='ls:ll:la:cd:pwd:exit:history'

# Editor
export EDITOR=nano
export VISUAL=nano

# Pager
export PAGER=less
export LESS='-R --shift 5'

# Color settings
export LS_COLORS='di=01;34:ln=00;36:so=01;35:pi=40;33:ex=01;32:bd=40;33;01:cd=40;33;01:su=01;34:sg=01;36:tw=01;32:ow=01;33;01'

echo "Welcome to MaxRegner OS Terminal!"
echo "Type 'help' for available commands."
BASHRC

chown "$MAXREGNER_USER:$MAXREGNER_USER" /home/$MAXREGNER_USER/.bashrc

# Configure profile
cat > /home/$MAXREGNER_USER/.profile << 'PROFILE'
# MaxRegner OS Profile Configuration

# Source bashrc if running bash
if [ -n "$BASH_VERSION" ]; then
    if [ -f "$HOME/.bashrc" ]; then
        . "$HOME/.bashrc"
    fi
fi

# MaxRegner environment
MAXREGNER_HOME=/home/$MAXREGNER_USER
export MAXREGNER_HOME
MAXREGNER_OS=MaxRegner
export MAXREGNER_OS

# Path settings
PATH=$PATH:$HOME/bin:$HOME/.local/bin:/usr/local/bin
export PATH

# Editor
EDITOR=nano
export EDITOR
VISUAL=nano
export VISUAL

# Pager
PAGER=less
export PAGER

# Browser
BROWSER=firefox
export BROWSER

# MaxRegner specific
MAXREGNER_THEME=MaxRegner-Ultimate
export MAXREGNER_THEME
MAXREGNER_ICONS=MaxRegner-Icons
export MAXREGNER_ICONS
PROFILE

chown "$MAXREGNER_USER:$MAXREGNER_USER" /home/$MAXREGNER_USER/.profile

# Create MaxRegner bashrc
mkdir -p /etc/maxregner
cat > /etc/maxregner/bashrc << 'MAXREGNERBASHRC'
# MaxRegner OS Global Bash Configuration

# MaxRegner aliases
alias update='sudo apt update && sudo apt upgrade -y && sudo apt autoremove -y'
alias clean='sudo apt clean && sudo apt autoclean'
alias rebuild='sudo dpkg-reconfigure -a'
alias restart='sudo systemctl restart'
alias stop='sudo systemctl stop'
alias start='sudo systemctl start'
alias status='sudo systemctl status'
alias enable='sudo systemctl enable'
alias disable='sudo systemctl disable'

# MaxRegner functions
function maxregner-update() {
    echo "Updating MaxRegner OS..."
    sudo apt update
    sudo apt upgrade -y
    sudo apt autoremove -y
    sudo apt clean
    echo "Update complete!"
}

function maxregner-clean() {
    echo "Cleaning MaxRegner OS..."
    sudo apt clean
    sudo apt autoclean
    sudo rm -rf /var/lib/apt/lists/*
    sudo rm -rf /tmp/*
    sudo rm -rf /var/tmp/*
    echo "Cleanup complete!"
}

function maxregner-info() {
    echo "MaxRegner OS Information"
    echo "======================="
    echo "OS: MaxRegner OS"
    echo "Kernel: $(uname -r)"
    echo "Architecture: $(uname -m)"
    echo "CPU: $(grep -m 1 'model name' /proc/cpuinfo | cut -d: -f2 | xargs)"
    echo "Memory: $(free -h | awk '/Mem:/ {print $4}') available"
    echo "Disk: $(df -h / | awk 'NR==2 {print $4}') available"
    echo "======================="
}

# Export MaxRegner environment
export MAXREGNER_OS=MaxRegner
export MAXREGNER_VERSION=1.0
export MAXREGNER_HOME=/home/$MAXREGNER_USER
MAXREGNERBASHRC

echo ""
echo "========================================"
echo "MaxRegner Terminal Configuration Complete!"
echo "========================================"
