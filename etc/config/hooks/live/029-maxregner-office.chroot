#!/bin/bash

set -e

# MaxRegner user configuration
MAXREGNER_USER="${LIVE_USERNAME:-maxregner}"

MAXREGNER_HOME="/home/$MAXREGNER_USER"

# MaxRegner OS - Office Suite Configuration Hook
# Configures complete office productivity suite
echo "========================================"
echo "MaxRegner OS - Office Suite Hook"
echo "========================================"

# ============================================
# 1. INSTALL OFFICE PACKAGES
# ============================================

echo "[1/5] Installing office packages..."

# Install LibreOffice
apt-get install -y libreoffice libreoffice-gtk3 libreoffice-kde5 \
    libreoffice-sdbc-postgresql libreoffice-sdbc-mysql \
    libreoffice-base libreoffice-calc libreoffice-draw \
    libreoffice-impress libreoffice-math libreoffice-writer \
    libreoffice-l10n-en libreoffice-l10n-de libreoffice-l10n-fr \
    libreoffice-l10n-es libreoffice-l10n-it libreoffice-l10n-pt \
    libreoffice-help-en libreoffice-help-de libreoffice-help-fr 2>/dev/null || true

# Install additional office tools
apt-get install -y calligra calligra-l10n-engb calligra-l10n-de \
    gnumeric abacus gnuplot dia inkscape scribus \
    evolution evolution-ews evolution-plugins evolution-rss \
    evolution-mapi evolution-couchdb evolution-spamassassin \
    gnome-contacts gnome-calendar gnome-documents \
    gnome-font-viewer gnome-characters 2>/dev/null || true

# ============================================
# 2. CONFIGURE LIBREOFFICE
# ============================================

echo "[2/5] Configuring LibreOffice..."

# Create LibreOffice configuration
mkdir -p /home/$MAXREGNER_USER/.config/libreoffice/4/user

cat > /home/$MAXREGNER_USER/.config/libreoffice/4/user/registrymodifications.xcu << 'LOCONF'
<?xml version="1.0" encoding="UTF-8"?>
<oor:items xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema" oor:name="MaxRegner OS LibreOffice Configuration" oor:package="org.openoffice.Office">

  <!-- Writer settings -->
  <item oor:name="Writer" oor:package="org.openoffice.Office.Writer">
    <prop oor:name="DefaultFont" oor:type="xs:string">
      <value>Liberation Serif 12</value>
    </prop>
    <prop oor:name="StandardPageSize" oor:type="xs:string">
      <value>A4</value>
    </prop>
    <prop oor:name="AutoSpellCheck" oor:type="xs:boolean">
      <value>true</value>
    </prop>
  </item>

  <!-- Calc settings -->
  <item oor:name="Calc" oor:package="org.openoffice.Office.Calc">
    <prop oor:name="DefaultFont" oor:type="xs:string">
      <value>Liberation Sans 10</value>
    </prop>
    <prop oor:name="PrecisionAsShown" oor:type="xs:boolean">
      <value>true</value>
    </prop>
  </item>

  <!-- Impress settings -->
  <item oor:name="Impress" oor:package="org.openoffice.Office.Impress">
    <prop oor:name="DefaultFont" oor:type="xs:string">
      <value>Liberation Sans 24</value>
    </prop>
    <prop oor:name="ShowPreview" oor:type="xs:boolean">
      <value>true</value>
    </prop>
  </item>

  <!-- General settings -->
  <item oor:name="Common" oor:package="org.openoffice.Office.Common">
    <prop oor:name="Save" oor:package="org.openoffice.Office.Common.Save">
      <prop oor:name="AutoSave" oor:type="xs:boolean">
        <value>true</value>
      </prop>
      <prop oor:name="AutoSaveTime" oor:type="xs:int">
        <value>10</value>
      </prop>
      <prop oor:name="Backup" oor:type="xs:boolean">
        <value>true</value>
      </prop>
      <prop oor:name="WarnAlterSaveAs" oor:type="xs:boolean">
        <value>true</value>
      </prop>
    </prop>
    <prop oor:name="View" oor:package="org.openoffice.Office.Common.View">
      <prop oor:name="ShowStatusBar" oor:type="xs:boolean">
        <value>true</value>
      </prop>
      <prop oor:name="ShowToolbar" oor:type="xs:boolean">
        <value>true</value>
      </prop>
    </prop>
  </item>

  <!-- Language settings -->
  <item oor:name="Linguistic" oor:package="org.openoffice.Office.Linguistic">
    <prop oor:name="DefaultLocale" oor:type="xs:string">
      <value>en-US</value>
    </prop>
    <prop oor:name="AvailableLocales" oor:type="xs:string">
      <value>en-US de-DE fr-FR es-ES it-IT pt-PT ru-RU</value>
    </prop>
  </item>

</oor:items>
LOCONF

chown -R "$MAXREGNER_USER" "$MAXREGNER_USER" /home/$MAXREGNER_USER/.config/libreoffice

# ============================================
# 3. CONFIGURE EVOLUTION
# ============================================

echo "[3/5] Configuring Evolution..."

# Create Evolution configuration
mkdir -p /home/$MAXREGNER_USER/.config/evolution
mkdir -p /home/$MAXREGNER_USER/.config/evolution/mail
cat > /home/$MAXREGNER_USER/.config/evolution/mail/config << 'EVOMAILCONF'
# MaxRegner OS Evolution Mail Configuration

[Default]
email_format=html
default_font=Liberation Sans 10
reply_format=html
forward_format=html

[Composer]
auto_save=true
auto_save_interval=5
spell_check=true
spell_check_language=en_US

[Display]
show_emoticons=true
show_headers=false
show_images=true

[Security]
encryption_method=pgp
signing_method=pgp
warn_about_unsigned=false
warn_about_encrypted=false
EVOMAILCONF

mkdir -p /home/$MAXREGNER_USER/.config/evolution/calendar
cat > /home/$MAXREGNER_USER/.config/evolution/calendar/config << 'EVOCALCONF'
# MaxRegner OS Evolution Calendar Configuration

[Default]
default_view=week
work_week=true
week_start_day=1

[Time]
timezone=America/New_York
display_24h=false
show_seconds=false

[Reminders]
enable_reminders=true
reminder_method=alert
reminder_time=15
EVOCALCONF

chown -R "$MAXREGNER_USER" "$MAXREGNER_USER" /home/$MAXREGNER_USER/.config/evolution

# ============================================
# 4. CONFIGURE DOCUMENT VIEWERS
# ============================================

echo "[4/5] Configuring document viewers..."

# Install document viewers
apt-get install -y evince evince-common evince-dbg evince-dev \
    evince-nautilus okular kpdf apvlv zathura zathura-djvu \
    zathura-ps zathura-pdf-poppler 2>/dev/null || true

# Configure Evince
mkdir -p /home/$MAXREGNER_USER/.config/dconf
cat > /home/$MAXREGNER_USER/.config/dconf/user << 'EVINCECONF'
[org/gnome/evince]
continuous=true
cursor-blink=true
current-document=true
fullscreen=false
sidenav-page=false

[org/gnome/evince/default]
zoom=1.0

[org/gnome/evince/daemon]
automatic-reload=true

[org/gnome/evince/view]
text-selection=true
EVINCECONF

chown ${MAXREGNER_USER}:${MAXREGNER_USER} /home/$MAXREGNER_USER/.config/dconf/user

# ============================================
# 5. CONFIGURE OFFICE TEMPLATES
# ============================================

echo "[5/5] Configuring office templates..."

# Create office templates directory
mkdir -p /usr/share/maxregner/office/templates
mkdir -p /usr/share/maxregner/office/templates/writer
mkdir -p /usr/share/maxregner/office/templates/calc
mkdir -p /usr/share/maxregner/office/templates/impress

# Create LibreOffice templates
cat > /usr/share/maxregner/office/templates/writer/MaxRegner-Letter.ott << 'LETTERTEMPLATE'
<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:meta="urn:oasis:names:tc:opendocument:xmlns:meta:1.0" xmlns:number="urn:oasis:names:tc:opendocument:xmlns:datastyle:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" xmlns:chart="urn:oasis:names:tc:opendocument:xmlns:chart:1.0" xmlns:dr3d="urn:oasis:names:tc:opendocument:xmlns:dr3d:1.0" xmlns:math="http://www.w3.org/1998/Math/MathML" xmlns:form="urn:oasis:names:tc:opendocument:xmlns:form:1.0" xmlns:script="urn:oasis:names:tc:opendocument:xmlns:script:1.0" xmlns:ooo="http://openoffice.org/2004/office" xmlns:ooow="http://openoffice.org/2004/writer" xmlns:oooc="http://openoffice.org/2004/calc" xmlns:dom="http://www.w3.org/2001/xml-events" xmlns:xforms="http://www.w3.org/2002/xforms" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:rpt="http://openoffice.org/2005/report" xmlns:of="urn:oasis:names:tc:opendocument:xmlns:of:1.2" xmlns:xhtml="http://www.w3.org/1999/xhtml" xmlns:grddl="http://www.w3.org/2003/g/data-view#" xmlns:tableooo="http://openoffice.org/2009/table" xmlns:drawooo="http://openoffice.org/2010/draw" xmlns:calcext="urn:org:documentfoundation:names:experimental:calc:xmlns:calcext:1.0" xmlns:loext="urn:org:documentfoundation:names:experimental:office:xmlns:loext:1.0" xmlns:field="urn:openoffice:names:experimental:ooo-ms-interop:xmlns:field:1.0" xmlns:formx="urn:openoffice:names:experimental:ooxml-odf-interop:xmlns:form:1.0" xmlns:css3t="http://www.w3.org/1999/xhtml#" office:version="1.3">
<office:scripts/>
<office:font-face-decls>
<style:font-face style:name="Liberation Serif" svg:font-family="Liberation Serif" style:font-family-generic="roman" style:font-pitch="variable"/>
<style:font-face style:name="Liberation Sans" svg:font-family="Liberation Sans" style:font-family-generic="swiss" style:font-pitch="variable"/>
</office:font-face-decls>
<office:automatic-styles/>
<office:body>
<office:text>
<text:sequence-decls>
<text:sequence-decl text:display-outline-level="0" text:name="Illustration"/>
<text:sequence-decl text:display-outline-level="0" text:name="Table"/>
<text:sequence-decl text:display-outline-level="0" text:name="Text"/>
<text:sequence-decl text:display-outline-level="0" text:name="Drawing"/>
</text:sequence-decls>
<text:p text:style-name="Standard">MaxRegner OS Letter Template</text:p>
<text:p text:style-name="Standard"/>
<text:p text:style-name="Standard">Date: </text:p>
<text:p text:style-name="Standard"/>
<text:p text:style-name="Standard">Subject: </text:p>
<text:p text:style-name="Standard"/>
<text:p text:style-name="Standard">Dear </text:p>
</office:text>
</office:body>
</office:document>
LETTERTEMPLATE

echo ""
echo "========================================"
echo "MaxRegner Office Suite Complete!"
echo "========================================"
