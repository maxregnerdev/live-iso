#!/bin/bash
# MaxRegner OS - Security Policies Configuration Hook
# Configures comprehensive security settings

set -e

echo "========================================"
echo "MaxRegner OS - Security Policies Hook"
echo "========================================"

# ============================================
# 1. CONFIGURE FIREWALL
# ============================================

echo "[1/5] Configuring firewall..."

# Install and configure UFW
apt-get install -y ufw ufw-knockd 2>/dev/null || true

# Reset and configure firewall
ufw --force reset 2>/dev/null || true
ufw default deny incoming 2>/dev/null || true
ufw default allow outgoing 2>/dev/null || true

# Allow essential services
ufw allow ssh 2>/dev/null || true
ufw allow http 2>/dev/null || true
ufw allow https 2>/dev/null || true
ufw allow 80/tcp 2>/dev/null || true
ufw allow 443/tcp 2>/dev/null || true
ufw allow 53/udp 2>/dev/null || true
ufw allow 67/udp 2>/dev/null || true
ufw allow 68/udp 2>/dev/null || true

# Enable firewall
ufw --force enable 2>/dev/null || true

# Configure firewall logging
cat > /etc/ufw/ufw.conf << 'UFWEOF'
# MaxRegner OS UFW Configuration

# Firewall enabled
ENABLED=yes

# Logging
LOGGING=medium
LOGLEVEL=low

# Default policies
DEFAULT_INPUT_POLICY="DENY"
DEFAULT_OUTPUT_POLICY="ALLOW"
DEFAULT_FORWARD_POLICY="DENY"
DEFAULT_APPLICATION_POLICY="SKIP"

# Application profiles
MANAGE_BUILTINS=no

# IP tables
IPT_SYSCTL="/etc/ufw/sysctl.conf"
IPT_MODULES="nf_conntrack_ftp nf_nat_ftp nf_conntrack_netbios_ns"

# IPv6
IPV6=yes
UFWEOF

# ============================================
# 2. CONFIGURE APPARMOR
# ============================================

echo "[2/5] Configuring AppArmor..."

# Install AppArmor tools
apt-get install -y apparmor apparmor-profiles apparmor-utils apparmor-notify 2>/dev/null || true

# Enable AppArmor
systemctl enable apparmor 2>/dev/null || true
systemctl start apparmor 2>/dev/null || true

# Configure AppArmor profiles
cat > /etc/apparmor.d/maxregner-tunables << 'APPEOF'
# MaxRegner OS AppArmor Tunables

# Network access
@{HOME} = /home/* /root/
@{HOMEDIRS} = /home/ /root/ /var/home/

# User directories
@{USERDIRS} = /home/*/ /root/ /var/home/*/

# Cache directories
@{CACHEDIRS} = /tmp/ /var/tmp/ /var/cache/

# Library directories
@{LIBDIRS} = /lib/ /lib64/ /usr/lib/ /usr/lib64/ /usr/local/lib/ /usr/local/lib64/

# Binary directories
@{BINDIRS} = /bin/ /sbin/ /usr/bin/ /usr/sbin/ /usr/local/bin/ /usr/local/sbin/

# MaxRegner specific
@{MAXREGNER} = /opt/maxregner/ /etc/maxregner/ /var/lib/maxregner/
@{MAXREGNER_BIN} = /usr/local/bin/maxregner-*
@{MAXREGNER_ETC} = /etc/maxregner/**
@{MAXREGNER_VAR} = /var/lib/maxregner/**
APPEOF

# Create custom AppArmor profile
cat > /etc/apparmor.d/usr.local.bin.maxregner-hooks << 'APPEOF'
# MaxRegner OS AppArmor Profile for Hooks

#include <tunables/global>

/usr/local/bin/maxregner-* {
  #include <abstractions/base>
  #include <abstractions/bash>

  # Capabilities
  capability chown,
  capability dac_override,
  capability fowner,
  capability fsetid,
  capability kill,
  capability net_bind_service,
  capability setgid,
  capability setuid,
  capability sys_chroot,

  # Network
  network inet,
  network inet6,

  # File access
  @{HOME}/** rw,
  @{MAXREGNER_ETC}/** r,
  @{MAXREGNER_VAR}/** rw,
  /tmp/** rw,
  /var/tmp/** rw,
  /var/log/maxregner/** rw,

  # System access
  /bin/** ix,
  /sbin/** ix,
  /usr/bin/** ix,
  /usr/sbin/** ix,
  /usr/local/bin/** ix,

  # Deny dangerous operations
  deny /etc/** w,
  deny /usr/** w,
  deny /lib/** w,
  deny /boot/** w,
}
APPEOF

# Reload AppArmor
apparmor_parser -r /etc/apparmor.d/usr.local.bin.maxregner-hooks 2>/dev/null || true

# ============================================
# 3. CONFIGURE SSH HARDENING
# ============================================

echo "[3/5] Configuring SSH hardening..."

# Configure SSH
cat > /etc/ssh/sshd_config << 'SSHEOF'
# MaxRegner OS SSH Configuration

# Port and listening
Port 22
ListenAddress 0.0.0.0
ListenAddress ::

# Host keys
HostKey /etc/ssh/ssh_host_rsa_key
HostKey /etc/ssh/ssh_host_ecdsa_key
HostKey /etc/ssh/ssh_host_ed25519_key

# Authentication
LoginGraceTime 60
PermitRootLogin no
StrictModes yes
MaxAuthTries 3
MaxSessions 10

# Password authentication
PasswordAuthentication yes
KbdInteractiveAuthentication no
PermitEmptyPasswords no
ChallengeResponseAuthentication no

# Public key authentication
PubkeyAuthentication yes
AuthorizedKeysFile .ssh/authorized_keys

# Security
AllowAgentForwarding no
AllowTcpForwarding no
X11Forwarding yes
PermitTunnel no
AllowStreamLocalForwarding no

# Logging
LogLevel INFO
SyslogFacility AUTH
LogFile /var/log/ssh.log

# Session
ClientAliveInterval 300
ClientAliveCountMax 2
TCPKeepAlive yes

# Access control
AllowGroups ssh-users maxregner
DenyUsers root

# MaxRegner specific
Banner /etc/maxregner/ssh-banner
AcceptEnv LANG LC_*
PrintMotd no
SSHEOF

# Create SSH banner
cat > /etc/maxregner/ssh-banner << 'BANNEREOF'
==================================================
  MaxRegner OS - Secure Shell Access
==================================================

WARNING: Unauthorized access is strictly prohibited.

All connections are monitored and logged.
Any attempt to access this system without authorization
will be prosecuted to the full extent of the law.

For authorized users only.

==================================================
BANNEREOF

# Create SSH users group
groupadd ssh-users 2>/dev/null || true
usermod -aG ssh-users maxregner 2>/dev/null || true

# ============================================
# 4. CONFIGURE SECURITY KERNEL PARAMETERS
# ============================================

echo "[4/5] Configuring security kernel parameters..."

# Kernel hardening
cat > /etc/sysctl.d/60-maxregner-security.conf << 'SYSEOF'
# MaxRegner OS Security Kernel Parameters

# Network security
net.ipv4.conf.all.rp_filter = 1
net.ipv4.conf.default.rp_filter = 1
net.ipv4.conf.all.accept_redirects = 0
net.ipv4.conf.default.accept_redirects = 0
net.ipv4.conf.all.send_redirects = 0
net.ipv4.conf.default.send_redirects = 0
net.ipv4.conf.all.accept_source_route = 0
net.ipv4.conf.default.accept_source_route = 0
net.ipv4.conf.all.log_martians = 1
net.ipv4.conf.default.log_martians = 1

# IP spoofing protection
net.ipv4.conf.all.reverse_path_filter = 1
net.ipv4.conf.default.reverse_path_filter = 1

# SYN flood protection
net.ipv4.tcp_syncookies = 1
net.ipv4.tcp_max_syn_backlog = 2048
net.ipv4.tcp_synack_retries = 2

# ICMP security
net.ipv4.icmp_echo_ignore_broadcasts = 1
net.ipv4.icmp_ignore_bogus_error_responses = 1

# Kernel pointer protection
kernel.kptr_restrict = 2
kernel.dmesg_restrict = 1

# Memory protection
vm.mmap_rnd_bits = 32
vm.mmap_rnd_compat_bits = 16
vm.unprivileged_userfaultfd = 0

# Process protection
kernel.yama.ptrace_scope = 1
kernel.randomize_va_space = 2

# Module loading
kernel.modules_restricted = 1
kernel.modules_disabled = 0
SYSEOF

sysctl -p /etc/sysctl.d/60-maxregner-security.conf 2>/dev/null || true

# ============================================
# 5. CONFIGURE AUDITING
# ============================================

echo "[5/5] Configuring auditing..."

# Install auditd
apt-get install -y auditd audispd-plugins 2>/dev/null || true

# Configure auditd
cat > /etc/audit/auditd.conf << 'AUDITEOF'
# MaxRegner OS Audit Configuration

# Daemon settings
name = maxregner-auditd
max_log_file = 50
max_log_file_action = ROTATE
space_left = 75
space_left_action = SYSLOG
action_mail_acct = root
admin_space_left = 50
admin_space_left_action = SUSPEND
disk_full_action = SUSPEND
disk_error_action = SUSPEND

# Logging
log_file = /var/log/audit/audit.log
log_format = ENRICHED
log_group = root
priority_boost = 4
name_format = HOSTNAME
max_log_file_action = ROTATE

# Performance
disp_qos = lossy
max_log_file = 100
num_logs = 5
disp_qos = lossy

# Network
tcp_listen_port = 0
tcp_listen_addr = 0.0.0.0
tcp_client_ports = 1024-65535

# Flush
flush = INCREMENTAL_ASYNC
freq = 50
AUDITEOF

# Configure audit rules
cat > /etc/audit/rules.d/maxregner.rules << 'RULESEOF'
# MaxRegner OS Audit Rules

# Monitor file access
-w /etc/passwd -p wa -k user_changes
-w /etc/group -p wa -k user_changes
-w /etc/shadow -p wa -k user_changes
-w /etc/sudoers -p wa -k priv_esc

# Monitor authentication
-w /var/log/auth.log -p wa -k auth_log
-w /var/log/secure -p wa -k auth_log
-w /var/log/faillog -p wa -k auth_fail

# Monitor SSH
-w /etc/ssh/sshd_config -p wa -k ssh_config
-w /etc/ssh/ -p wa -k ssh_files

# Monitor system files
-w /etc/crontab -p wa -k cron_jobs
-w /etc/cron.d/ -p wa -k cron_jobs
-w /etc/cron.daily/ -p wa -k cron_jobs
-w /etc/cron.hourly/ -p wa -k cron_jobs
-w /etc/cron.monthly/ -p wa -k cron_jobs
-w /etc/cron.weekly/ -p wa -k cron_jobs

# Monitor kernel modules
-w /usr/lib/modules/ -p wa -k kernel_modules
-w /lib/modules/ -p wa -k kernel_modules

# Monitor system calls
-a exit,always -F arch=b64 -S execve -k exec_commands
-a exit,always -F arch=b32 -S execve -k exec_commands
-a exit,always -F arch=b64 -S execveat -k exec_commands
-a exit,always -F arch=b32 -S execveat -k exec_commands

# Monitor privilege escalation
-a exit,always -F arch=b64 -S setuid -k priv_esc
-a exit,always -F arch=b32 -S setuid -k priv_esc
-a exit,always -F arch=b64 -S setgid -k priv_esc
-a exit,always -F arch=b32 -S setgid -k priv_esc
RULESEOF

# Enable and start auditd
systemctl enable auditd 2>/dev/null || true
systemctl start auditd 2>/dev/null || true

echo ""
echo "========================================"
echo "MaxRegner Security Policies Complete!"
echo "========================================"
