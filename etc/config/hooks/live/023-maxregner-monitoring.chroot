#!/bin/bash
# MaxRegner OS - System Monitoring Configuration Hook
# Configures comprehensive system monitoring

set -e

echo "========================================"
echo "MaxRegner OS - Monitoring Hook"
echo "========================================"

# ============================================
# 1. INSTALL MONITORING TOOLS
# ============================================

echo "[1/5] Installing monitoring tools..."

# Install system monitoring packages
apt-get install -y htop iotop nmon iftop nethogs bmon \
    dstat sysstat iostat mpstat sar collectl vmstat \
    lsof strace ltrace perf ftrace 2>/dev/null || true

# Install network monitoring
apt-get install -y tcpdump wireshark tshark ngrep net-tools \
    iproute2 iputils-ping iputils-tracepath iputils-arping \
    mtr-tiny nmap zenmap 2>/dev/null || true

# Install Prometheus and Grafana
apt-get install -y prometheus prometheus-node-exporter \
    prometheus-alertmanager grafana 2>/dev/null || true

# ============================================
# 2. CONFIGURE PROMETHEUS
# ============================================

echo "[2/5] Configuring Prometheus..."

# Configure Prometheus
cat > /etc/prometheus/prometheus.yml << 'PROMETHEUSYML'
# MaxRegner OS Prometheus Configuration

global:
  scrape_interval: 15s
  evaluation_interval: 15s
  scrape_timeout: 10s

# Alertmanager configuration
alerting:
  alertmanagers:
    - static_configs:
        - targets:
          - localhost:9093

# Rule files
rule_files:
  - "/etc/prometheus/rules/*.yml"

# Scrape configurations
scrape_configs:
  # Prometheus itself
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

  # Node exporter
  - job_name: 'node-exporter'
    static_configs:
      - targets: ['localhost:9100']

  # System metrics
  - job_name: 'system'
    static_configs:
      - targets: ['localhost:9100']
    metric_relabel_configs:
      - source_labels: [__name__]
        regex: 'node_.*'
        action: keep

  # MaxRegner specific
  - job_name: 'maxregner'
    static_configs:
      - targets: ['localhost:9101']
    metrics_path: '/metrics'
    scheme: 'http'
PROMETHEUSYML

# Configure Prometheus rules
mkdir -p /etc/prometheus/rules
cat > /etc/prometheus/rules/maxregner.rules.yml << 'PROMRULES'
# MaxRegner OS Prometheus Rules

groups:
- name: maxregner.rules
  rules:

  # CPU alerts
  - alert: HighCPUUsage
    expr: 100 - (avg by(instance) (rate(node_cpu_seconds_total{mode="idle"}[1m])) * 100) > 90
    for: 5m
    labels:
      severity: warning
    annotations:
      summary: "High CPU usage on {{ $labels.instance }}"
      description: "CPU usage is {{ $value }}%"

  # Memory alerts
  - alert: HighMemoryUsage
    expr: (node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes) / node_memory_MemTotal_bytes * 100 > 90
    for: 5m
    labels:
      severity: warning
    annotations:
      summary: "High memory usage on {{ $labels.instance }}"
      description: "Memory usage is {{ $value }}%"

  # Disk alerts
  - alert: HighDiskUsage
    expr: 100 - (node_filesystem_avail_bytes{mountpoint="/"} / node_filesystem_size_bytes{mountpoint="/"} * 100) > 90
    for: 5m
    labels:
      severity: warning
    annotations:
      summary: "High disk usage on {{ $labels.instance }}"
      description: "Disk usage is {{ $value }}%"

  # Network alerts
  - alert: HighNetworkUsage
    expr: rate(node_network_receive_bytes_total[1m]) > 100000000
    for: 5m
    labels:
      severity: warning
    annotations:
      summary: "High network usage on {{ $labels.instance }}"
      description: "Network usage is {{ $value }} bytes/sec"

  # Temperature alerts
  - alert: HighTemperature
    expr: node_hwmon_temp_celsius > 80
    for: 1m
    labels:
      severity: critical
    annotations:
      summary: "High temperature on {{ $labels.instance }}"
      description: "Temperature is {{ $value }}°C"
PROMRULES

# ============================================
# 3. CONFIGURE GRAFANA
# ============================================

echo "[3/5] Configuring Grafana..."

# Configure Grafana
cat > /etc/grafana/grafana.ini << 'GRAFANAINI'
# MaxRegner OS Grafana Configuration

[paths]
data = /var/lib/grafana
temp_data_lifetime = 24h
plugins = /var/lib/grafana/plugins
provisioning = /etc/grafana/provisioning

[server]
protocol = http
http_addr = 0.0.0.0
http_port = 3000
domain = localhost
enforce_domain = false
root_url = %(protocol)s://%(domain)s:%(http_port)s/
serve_from_sub_path = false
static_root_path = public
enable_gzip = true
cert_file = 
key_file = 

[database]
type = sqlite3
path = grafana.db
max_idle_conn = 2
max_open_conn = 10

[session]
provider = file
provider_config = sessions
session_lifetime = 86400
cookie_name = grafana_sess
cookie_secure = false
session_expiration = 86400

[dataproxy]
timeout = 30

[analytics]
reporting_enabled = true
google_analytics_ua_id = 

[security]
disable_gravatar = false
enable_gzip = true
cookie_username = grafana_user
cookie_remember_name = grafana_remember

[auth]
disable_login_form = false
disable_signout_menu = false

[auth.anonymous]
enabled = false

[auth.github]
enabled = false

[auth.generic_oauth]
enabled = false

[auth.grafana_com]
enabled = false

[auth.ldap]
enabled = false

[auth.proxy]
enabled = false

[auth.basic]
enabled = true

[users]
allow_sign_up = false
allow_org_create = false
auto_assign_org = true
auto_assign_org_role = Viewer

[auth.saml]
enabled = false

[auth.azuread]
enabled = false
GRAFANAINI

# Create Grafana datasource
mkdir -p /etc/grafana/provisioning/datasources
cat > /etc/grafana/provisioning/datasources/maxregner.yaml << 'GRAFDATASOURCE'
# MaxRegner OS Grafana Datasource Configuration

apiVersion: 1

datasources:
  - name: Prometheus
    type: prometheus
    access: proxy
    url: http://localhost:9090
    isDefault: true
    editable: false
    jsonData:
      tlsAuth: false
      tlsAuthWithCACert: false
    version: 1
GRAFDATASOURCE

# ============================================
# 4. CONFIGURE NODE EXPORTER
# ============================================

echo "[4/5] Configuring Node Exporter..."

# Configure Node Exporter
cat > /etc/default/prometheus-node-exporter << 'NODEEXPORTER'
# MaxRegner OS Node Exporter Configuration

ARGS="--web.listen-address=0.0.0.0:9100"
ARGS="$ARGS --path.rootfs=/"
ARGS="$ARGS --collector.textfile.directory=/var/lib/prometheus/node-exporter"
ARGS="$ARGS --collector.systemd"
ARGS="$ARGS --collector.processes"
ARGS="$ARGS --collector.logind"
ARGS="$ARGS --no-collector.edac"
ARGS="$ARGS --no-collector.infiniband"
NODEEXPORTER

# ============================================
# 5. ENABLE AND START SERVICES
# ============================================

echo "[5/5] Enabling monitoring services..."

# Enable and start services
systemctl enable prometheus 2>/dev/null || true
systemctl enable prometheus-node-exporter 2>/dev/null || true
systemctl enable grafana-server 2>/dev/null || true
systemctl enable sysstat 2>/dev/null || true

# Start services
systemctl start prometheus 2>/dev/null || true
systemctl start prometheus-node-exporter 2>/dev/null || true
systemctl start grafana-server 2>/dev/null || true
systemctl start sysstat 2>/dev/null || true

# Create monitoring directories
mkdir -p /var/lib/prometheus
mkdir -p /var/lib/grafana
mkdir -p /var/log/prometheus
mkdir -p /var/log/grafana

# Set permissions
chown -R prometheus:prometheus /var/lib/prometheus
chown -R grafana:grafana /var/lib/grafana

echo ""
echo "========================================"
echo "MaxRegner Monitoring Complete!"
echo "========================================"
